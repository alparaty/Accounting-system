          <span><span class="ctx-icon">📥</span> لصق المحتوى</span>
          <span class="ctx-kbd">Ctrl+V</span>
        </div>
        <div class="context-menu-item danger" onclick="window.onyxApp.contextRowAction('delete', ${rowIndex})">
          <span><span class="ctx-icon">🗑️</span> حذف هذا السطر</span>
          <span class="ctx-kbd">Del</span>
        </div>

        <div class="context-menu-divider"></div>

        <div class="context-menu-header">
          <span>استعلامات وتاريخ الأسعار (${hist.itemName || 'الصنف'})</span>
        </div>
        <div class="context-menu-price-row" onclick="window.onyxApp.applyPriceToInvoiceRow(${rowIndex}, ${hist.lastPurchasePrice}, 'آخر سعر شراء')" title="انقر لتطبيق سعر الشراء مباشرة">
          <span class="price-label">🛒 آخر سعر شراء:</span>
          <span class="price-badge">${store.formatCurrency(hist.lastPurchasePrice)}</span>
        </div>
        <div class="context-menu-price-row" style="${hist.lastSalePriceToCustomer ? '' : 'opacity:0.5; cursor:default;'}" onclick="${hist.lastSalePriceToCustomer ? `window.onyxApp.applyPriceToInvoiceRow(${rowIndex}, ${hist.lastSalePriceToCustomer}, 'آخر بيع للزبون')` : ''}" title="${hist.lastSalePriceToCustomer ? 'انقر لتطبيق آخر بيع للزبون' : 'لا توجد فواتير سابقة لهذا الزبون'}">
          <span class="price-label">👤 آخر بيع للزبون:</span>
          <span class="price-badge">${hist.lastSalePriceToCustomer ? store.formatCurrency(hist.lastSalePriceToCustomer) : 'لا توجد سوابق'}</span>
        </div>
        <div class="context-menu-price-row" onclick="window.onyxApp.applyPriceToInvoiceRow(${rowIndex}, ${hist.wholesalePrice}, 'سعر الجملة')" title="انقر لتطبيق سعر الجملة">
          <span class="price-label">🏢 سعر الجملة:</span>
          <span class="price-badge">${store.formatCurrency(hist.wholesalePrice)}</span>
        </div>
        <div class="context-menu-price-row" onclick="window.onyxApp.applyPriceToInvoiceRow(${rowIndex}, ${hist.retailPrice}, 'سعر المفرق')" title="انقر لتطبيق سعر المفرق">
          <span class="price-label">🏷️ سعر المفرق (تجزئة):</span>
          <span class="price-badge">${store.formatCurrency(hist.retailPrice)}</span>
        </div>
        <div class="context-menu-price-row profit-row">
          <span class="price-label">📈 هامش الربح الحالي:</span>
          <span class="profit-badge">${hist.profitMarginPercent}% (${store.formatCurrency(hist.profitMarginAmount)})</span>
        </div>
      `;

      document.body.appendChild(menu);

      // تحديد موقع ظهور القائمة بذكاء ضمن حدود الشاشة
      let posX = event ? event.clientX : window.innerWidth / 2;
      let posY = event ? event.clientY : window.innerHeight / 2;
      const mWidth = 290;
      const mHeight = 310;
      if (posX + mWidth > window.innerWidth) posX = window.innerWidth - mWidth - 12;
      if (posY + mHeight > window.innerHeight) posY = window.innerHeight - mHeight - 12;

      menu.style.left = `${Math.max(10, posX)}px`;
      menu.style.top = `${Math.max(10, posY)}px`;

      // إغلاق القائمة عند النقر خارجها أو ضغط Esc
      const onDocClick = (e) => {
        if (!menu.contains(e.target)) {
          menu.remove();
          window.removeEventListener('click', onDocClick);
          window.removeEventListener('keydown', onDocKey);
        }
      };
      const onDocKey = (e) => {
        if (e.key === 'Escape') {
          menu.remove();
          window.removeEventListener('click', onDocClick);
          window.removeEventListener('keydown', onDocKey);
        }
      };
      setTimeout(() => {
        window.addEventListener('click', onDocClick);
        window.addEventListener('keydown', onDocKey);
      }, 10);
    },

