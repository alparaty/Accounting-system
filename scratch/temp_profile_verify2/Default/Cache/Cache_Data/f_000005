  function initSalesExcelGridListeners() {
    const cells = document.querySelectorAll('#sales-excel-main-table td.excel-cell');
    const coordBox = document.getElementById('sales-coord-box');
    const fxInput = document.getElementById('sales-fx-input');

    cells.forEach(cell => {
      cell.addEventListener('click', () => {
        cells.forEach(c => c.classList.remove('selected'));
        cell.classList.add('selected');
        selectedSalesExcelCell = cell;

        const col = cell.dataset.col;
        const row = cell.dataset.row;
        if (coordBox) coordBox.textContent = `${col}${row}`;
        if (fxInput) fxInput.value = cell.textContent.trim();
      });

      cell.addEventListener('input', () => {
        if (fxInput && cell === selectedSalesExcelCell) {
          fxInput.value = cell.textContent.trim();
        }
        recalculateSalesExcelTotals();
      });

      cell.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const nextRow = Number(cell.dataset.row) + 1;
          const col = cell.dataset.col;
          const nextCell = document.querySelector(`#sales-excel-main-table td.excel-cell[data-col="${col}"][data-row="${nextRow}"]`);
          if (nextCell) {
            nextCell.focus();
            nextCell.click();
          }
        }
      });
    });

    const firstCell = document.querySelector('#sales-excel-main-table td.excel-cell[data-col="A"][data-row="1"]');
    if (firstCell) firstCell.click();
  }

  function recalculateSalesExcelTotals() {
    if (activeSalesExcelTab === 'invoices') {
      const grossCells = document.querySelectorAll('#sales-excel-tbody td.excel-cell[data-col="F"]');
      const discountCells = document.querySelectorAll('#sales-excel-tbody td.excel-cell[data-col="G"]');
      const netCells = document.querySelectorAll('#sales-excel-tbody td.excel-cell[data-col="H"]');
      const commCells = document.querySelectorAll('#sales-excel-tbody td.excel-cell[data-col="J"]');

      let sumGross = 0;
      grossCells.forEach(c => sumGross += (parseFloat(c.textContent.replace(/,/g, '').trim()) || 0));

      let sumDiscount = 0;
      discountCells.forEach(c => sumDiscount += (parseFloat(c.textContent.replace(/,/g, '').trim()) || 0));

      let sumNet = 0;
      netCells.forEach(c => sumNet += (parseFloat(c.textContent.replace(/,/g, '').trim()) || 0));

      let sumComm = 0;
      commCells.forEach(c => sumComm += (parseFloat(c.textContent.replace(/,/g, '').trim()) || 0));

      const totalGrossEl = document.getElementById('sales-total-gross');
      const totalDiscountEl = document.getElementById('sales-total-discount');
      const totalNetEl = document.getElementById('sales-total-net');
      const totalCommEl = document.getElementById('sales-total-commission');

      if (totalGrossEl) totalGrossEl.textContent = sumGross.toLocaleString();
      if (totalDiscountEl) totalDiscountEl.textContent = sumDiscount.toLocaleString();
      if (totalNetEl) totalNetEl.textContent = sumNet.toLocaleString();
      if (totalCommEl) totalCommEl.textContent = sumComm.toLocaleString();

      const kpiGross = document.getElementById('kpi-gross-sales');
      const kpiDisc = document.getElementById('kpi-discount');
      const kpiNet = document.getElementById('kpi-net-sales');
      const kpiComm = document.getElementById('kpi-commissions');
      if (kpiGross) kpiGross.textContent = store.formatCurrency(sumGross);
      if (kpiDisc) kpiDisc.textContent = store.formatCurrency(sumDiscount);
      if (kpiNet) kpiNet.textContent = store.formatCurrency(sumNet);
      if (kpiComm) kpiComm.textContent = store.formatCurrency(sumComm);

      const statNet = document.getElementById('sales-stat-net');
      const statComm = document.getElementById('sales-stat-comm');
      if (statNet) statNet.textContent = store.formatCurrency(sumNet);
      if (statComm) statComm.textContent = store.formatCurrency(sumComm);
    }
  }

