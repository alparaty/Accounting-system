        const vendorMatch = (e.vendorName || '').toLowerCase().includes(q);
        if (!numMatch && !descMatch && !vendorMatch) return false;
      }
      if (expensesFilterCategory !== 'ALL' && e.categoryId !== expensesFilterCategory) return false;
      if (expensesFilterStatus !== 'ALL' && e.paymentStatus !== expensesFilterStatus) return false;
      if (expensesFilterSource !== 'ALL' && e.paymentSource !== expensesFilterSource) return false;
