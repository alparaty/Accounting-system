    updateReconciliationBookQty: () => {
      const itemCode = document.getElementById('rec-item-select')?.value;
      const wh = document.getElementById('rec-wh-select')?.value || 'WH01';
      const item = (store.state.items || []).find(i => i.code === itemCode);
      const bookInput = document.getElementById('rec-book-qty');
      const actualInput = document.getElementById('rec-actual-qty');
      if (item && bookInput) {
        const bookQty = (item.whStock && item.whStock[wh] !== undefined) ? item.whStock[wh] : 0;
        bookInput.value = bookQty;
        if (actualInput && !actualInput.value) {
          actualInput.value = bookQty;
        }
        window.onyxApp.calcReconciliationDiff();
      }
    },

    calcReconciliationDiff: () => {
      const bookQty = Number(document.getElementById('rec-book-qty')?.value) || 0;
      const actualQty = Number(document.getElementById('rec-actual-qty')?.value) || 0;
      const diffDisplay = document.getElementById('rec-diff-display');
      if (diffDisplay) {
        const diff = actualQty - bookQty;
        if (diff === 0) {
          diffDisplay.value = "مطابق تماماً (0)";
          diffDisplay.style.color = "#15803d";
        } else if (diff > 0) {
          diffDisplay.value = `زيادة مخزنية (+${diff})`;
          diffDisplay.style.color = "#15803d";
        } else {
          diffDisplay.value = `عجز مخزني (${diff})`;
          diffDisplay.style.color = "#b91c1c";
        }
      }
    },

    submitStockReconciliation: () => {
      const itemCode = document.getElementById('rec-item-select')?.value;
      const wh = document.getElementById('rec-wh-select')?.value || 'WH01';
      const actualQty = Number(document.getElementById('rec-actual-qty')?.value);
      const reason = document.getElementById('rec-reason')?.value.trim() || 'تسوية جردية';

      if (isNaN(actualQty) || actualQty < 0) {
        window.showOnyxToast("يرجى إدخال كمية جرد صحيحة", "⚠️");
        return;
      }

      const item = (store.state.items || []).find(i => i.code === itemCode);
      if (!item) return;

      if (!item.whStock) item.whStock = { WH01: 0, WH02: 0 };
      const oldQty = item.whStock[wh] || 0;
      item.whStock[wh] = actualQty;
      item.currentStock = (item.whStock.WH01 || 0) + (item.whStock.WH02 || 0);

      store.save();
      window.showOnyxToast(`تم اعتماد تسوية الصنف [${item.name}] بالمستودع ${wh} من (${oldQty}) إلى (${actualQty})`, "✔");
      closeModal();
      renderActiveScreen();
    },

