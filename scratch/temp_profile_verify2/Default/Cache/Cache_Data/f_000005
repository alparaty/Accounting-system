    closeFinancialYearPrompt: () => {
      if (!confirm(`هل أنت متأكد من إقفال السنة المالية ${store.state.system.activeYear}؟ سيتم تصفير حسابات الإيرادات والمصروفات وترحيل صافي النتيجة إلى الأرباح والخسائر المرحلة (ح/ 311201) وتدوير الأرصدة.`)) {
        return;
