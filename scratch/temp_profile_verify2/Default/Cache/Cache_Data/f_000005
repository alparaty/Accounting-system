    },

    removeContextMenuRow: () => {
      const menu = document.getElementById('gridContextMenu');
      if (menu) menu.style.display = 'none';
      const tr = window.onyxApp.activeContextTargetRow;
      if (tr) {
        tr.remove();
        if (window.onyxApp.calcAlameenInvoiceTotals) window.onyxApp.calcAlameenInvoiceTotals();
        if (window.onyxApp.calcBranchInvoiceTotals) window.onyxApp.calcBranchInvoiceTotals();
        window.showOnyxToast("تم حذف سطر المادة", "🗑️");
      }
    },

    contextEditAction: (act) => {
      const menu = document.getElementById('gridContextMenu');
      if (menu) menu.style.display = 'none';
      window.showOnyxToast(`تم تنفيذ أمر التحرير: ${act}`, "ℹ️");
    }
  };

  // إخفاء القائمة المنسدلة عند النقر في أي مكان آخر
  document.addEventListener('click', (e) => {
    const menu = document.getElementById('gridContextMenu');
    if (menu && menu.style.display !== 'none' && !menu.contains(e.target)) {
      menu.style.display = 'none';
    }
  });

  // تفويض حدث الزر الأيمن على شبكات الأصناف والفواتير
  document.addEventListener('contextmenu', (e) => {
    const tr = e.target.closest('tr');
    if (tr && (tr.closest('.alameen-table') || tr.closest('.branch-items-table') || tr.closest('#sales-excel-table') || tr.closest('.invoice-grid') || tr.closest('.onyx-grid'))) {
      if (window.onyxApp && window.onyxApp.bindGridContextMenu) {
        window.onyxApp.bindGridContextMenu(e, tr);
      }
    }
  });

  // تحديث ساعة الفرع كل ثانية
  setInterval(() => {
    const clock = document.getElementById('branch-clock');
    if (clock) clock.textContent = new Date().toLocaleTimeString('en-US', { hour12: true });
  }, 1000);

  // Initial load
  openScreen('dashboard');

  // تهيئة نمط الواجهة بناء على وضع المستخدم الحالي
  if (window.onyxApp && window.onyxApp.initializeInterfaceMode) {
    window.onyxApp.initializeInterfaceMode();
  }

  // تفعيل اختصار التنقل بمفتاح Enter في نموذج تسجيل الدخول
  const loginForm = document.getElementById('onyxLoginForm');
  if (loginForm) {
    const formControls = Array.from(loginForm.querySelectorAll('input, select'));
    formControls.forEach((inp, idx) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          if (inp.id === 'login-password' || idx === formControls.length - 1) {
            window.onyxApp.handleLoginSubmit(e);
          } else {
            const next = formControls[idx + 1];
            if (next) next.focus();
          }
        }
      });
    });
  }

  // إغلاق النافذة بمفتاح Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const overlay = document.getElementById('onyx-login-overlay');
      if (overlay && overlay.style.display !== 'none') {
        window.onyxApp.closeLoginModal();
      }
    }
  });

  // فحص بيئة التشغيل للنافذة
  const overlay = document.getElementById('onyx-login-overlay');
  const isHeadless = navigator.webdriver || window.location.search.includes('headless') || window.location.search.includes('autologin');
  if (isHeadless) {
    if (overlay) overlay.style.display = 'none';
  } else {
    if (overlay) overlay.style.display = 'flex';
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initOnyxApp);
} else {
  initOnyxApp();
}
