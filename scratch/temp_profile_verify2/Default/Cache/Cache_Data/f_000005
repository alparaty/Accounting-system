    /* =========================================================================
       نظام إدارة نوافذ سطح المكتب MDI (التحريك، التكبير، التبديل، التصغير، الإغلاق)
       ========================================================================= */
    initDraggableWindows: () => {
      window.onyxApp.makeWindowDraggable('alameenMenuWindow', 'alameenMenuTitlebar');
      window.onyxApp.makeWindowDraggable('alameenInvoiceWindow', 'alameenInvoiceTitlebar');

      // إغلاق القوائم المنسدلة عند النقر في أي مكان آخر
      if (!window._alameenDropdownBound) {
        window._alameenDropdownBound = true;
        document.addEventListener('click', (e) => {
          const dd = document.getElementById('alameen-invoice-dropdown');
          const btn = document.getElementById('btn-alameen-invoice-menu');
          if (dd && dd.style.display !== 'none') {
            if (!dd.contains(e.target) && (!btn || !btn.contains(e.target))) {
              dd.style.display = 'none';
            }
          }
        });
      }
    },

    makeWindowDraggable: (winId, titlebarId) => {
      const winEl = document.getElementById(winId);
      const barEl = document.getElementById(titlebarId);
      if (!winEl || !barEl || winEl._draggableBound) return;
      winEl._draggableBound = true;

      // عند النقر على أي مكان داخل النافذة يتم رفعها للمقدمة
      winEl.addEventListener('mousedown', () => {
        if (winId === 'alameenInvoiceWindow') {
          window.onyxApp.bringInvoiceWindowToFront();
        } else {
          window.onyxApp.bringMenuWindowToFront();
        }
      });

      // النقر المزدوج على شريط العنوان يكبر / يستعيد حجم النافذة
      barEl.addEventListener('dblclick', (e) => {
        if (e.target.closest('button') || e.target.closest('.al-w-btn')) return;
        if (winId === 'alameenInvoiceWindow') {
          window.onyxApp.toggleMaximizeInvoiceWindow();
        }
      });

      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let origLeft = 0;
      let origTop = 0;

      barEl.addEventListener('mousedown', (e) => {
        if (e.target.closest('button') || e.target.closest('.al-w-btn')) return;

        const parent = winEl.parentElement || document.body;
        const pRect = parent.getBoundingClientRect();
        const wRect = winEl.getBoundingClientRect();

        // إذا كانت النافذة مكبرة وسحب المستخدم شريط العنوان، يتم استعادتها تلقائياً مع السحب بسلاسة
        if (winEl.classList.contains('is-maximized')) {
          winEl.classList.remove('is-maximized');
          const maxBtn = document.getElementById('btn-maximize-invoice-window');
          if (maxBtn) {
            maxBtn.textContent = '🗖';
            maxBtn.title = 'تكبير النافذة لملء كامل الشاشة [Maximize]';
          }
          const targetW = Math.min(1200, Math.max(860, parent.clientWidth - 80));
          const targetH = Math.min(700, Math.max(500, parent.clientHeight - 50));
          winEl.style.width = `${targetW}px`;
          winEl.style.height = `${targetH}px`;
          origLeft = Math.max(10, Math.min(e.clientX - pRect.left - Math.round(targetW / 2), parent.clientWidth - targetW - 20));
          origTop = Math.max(10, e.clientY - pRect.top - 15);
        } else {
          origLeft = wRect.left - pRect.left;
          origTop = wRect.top - pRect.top;
          winEl.style.width = `${Math.min(wRect.width, parent.clientWidth - 40)}px`;
          winEl.style.height = `${Math.min(wRect.height, parent.clientHeight - 40)}px`;
        }

        // تثبيت الإحداثيات الحالية لتفادي القفز
        winEl.style.left = `${origLeft}px`;
        winEl.style.top = `${origTop}px`;
        winEl.style.right = 'auto';
        winEl.style.bottom = 'auto';

        const onMouseMove = (ev) => {
          if (!isDragging) return;
          const dx = ev.clientX - startX;
          const dy = ev.clientY - startY;

          let newL = origLeft + dx;
          let newT = origTop + dy;

          const pW = parent.clientWidth;
          const pH = parent.clientHeight;
          newL = Math.max(0, Math.min(newL, pW - 100));
          newT = Math.max(0, Math.min(newT, pH - 40));

          winEl.style.left = `${newL}px`;
          winEl.style.top = `${newT}px`;
        };

        const onMouseUp = () => {
          isDragging = false;
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
        };

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });
    },

