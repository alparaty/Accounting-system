    // تنفيذ أوامر تحرير الأسطر (تراجع، قص، نسخ، لصق، حذف)
    contextRowAction: (action, rowIndex) => {
      const menu = document.getElementById('onyx-adaptive-context-menu');
      if (menu) menu.remove();

      window.onyxApp.syncAdaptiveRowsFromDOM();
      const row = window.onyxApp.adaptiveInvoiceRows[rowIndex];

      if (action === 'copy' && row) {
        window.onyxApp.invoiceRowClipboard = JSON.parse(JSON.stringify(row));
        window.showOnyxToast(`تم نسخ بيانات السطر #${rowIndex + 1} إلى الحافظة`, "📋");
      } else if (action === 'cut' && row) {
        window.onyxApp.invoiceRowClipboard = JSON.parse(JSON.stringify(row));
        window.onyxApp.deleteAdaptiveInvoiceRow(rowIndex);
        window.showOnyxToast(`تم قص السطر وحفظه بالحافظة`, "✂️");
      } else if (action === 'paste') {
        if (window.onyxApp.invoiceRowClipboard) {
          window.onyxApp.adaptiveInvoiceRows[rowIndex] = JSON.parse(JSON.stringify(window.onyxApp.invoiceRowClipboard));
          window.onyxApp.renderAdaptiveInvoiceRowsTable();
          window.onyxApp.onAdaptiveInvoiceGeneralCalc();
          window.showOnyxToast(`تم لصق الصنف [${window.onyxApp.invoiceRowClipboard.name}] بنجاح`, "📥");
        } else {
          window.showOnyxToast("الحافظة فارغة! انسخ سطر مادة أولاً", "⚠️");
        }
      } else if (action === 'undo') {
        if (window.onyxApp.invoiceRowHistory[rowIndex]) {
          window.onyxApp.adaptiveInvoiceRows[rowIndex] = JSON.parse(JSON.stringify(window.onyxApp.invoiceRowHistory[rowIndex]));
          window.onyxApp.renderAdaptiveInvoiceRowsTable();
          window.onyxApp.onAdaptiveInvoiceGeneralCalc();
          window.showOnyxToast(`تم التراجع عن تعديلات السطر #${rowIndex + 1}`, "↩️");
        } else {
          window.showOnyxToast("لا توجد تعديلات محفوظة للتراجع عنها", "ℹ️");
        }
      } else if (action === 'delete') {
        window.onyxApp.deleteAdaptiveInvoiceRow(rowIndex);
      }
    },

    // حفظ الفاتورة الموحدة مع معالجة النمط
    submitAdaptiveSalesInvoice: (isImmediatePosting = false) => {
      try {
        const invNo = document.getElementById('adapt-inv-no')?.value;
        const date = document.getElementById('adapt-inv-date')?.value || new Date().toISOString().split('T')[0];
        const profileId = document.getElementById('adapt-profile-select')?.value;
        const profile = store.getInvoiceProfile(profileId);

        const customer = document.getElementById('adapt-inv-customer')?.value || '';
        const rep = document.getElementById('adapt-inv-rep')?.value || 'أحمد خالد العبسي';
        const repSelect = document.getElementById('adapt-inv-rep');
        const repRate = parseFloat(repSelect?.options[repSelect.selectedIndex]?.dataset?.rate) || 2.5;

        const type = document.getElementById('adapt-inv-type')?.value || (profile.isQuotation ? 'عرض سعر' : profile.paymentType || 'نقداً');
        const warehouse = document.getElementById('adapt-inv-warehouse')?.value || 'WH01';
        const cashBox = document.getElementById('adapt-inv-cashbox')?.value || '0101';
        const notes = document.getElementById('adapt-inv-notes')?.value || '';

        // جمع ومزامنة أسطر المواد
        window.onyxApp.syncAdaptiveRowsFromDOM();
        const validRows = (window.onyxApp.adaptiveInvoiceRows || []).filter(r => (r.code || r.name) && Number(r.qty) > 0);

        if (validRows.length === 0) {
          window.showOnyxToast("يرجى إدراج صنف واحد على الأقل في الفاتورة بكمية صالحة!", "⚠️");
          return;
        }

        const sinvGrossVal = Number(document.getElementById('sinv-gross')?.value) || 0;
        const sinvDiscVal = Number(document.getElementById('sinv-discount')?.value) || 0;
        const sinvStatusVal = document.getElementById('sinv-status')?.value;

        const grossAmount = sinvGrossVal > 0 ? sinvGrossVal : validRows.reduce((sum, r) => sum + (Number(r.qty) * Number(r.price)), 0);
        const discount = sinvDiscVal > 0 ? sinvDiscVal : validRows.reduce((sum, r) => sum + (Number(r.discount) || 0), 0);
        const netAmount = Math.max(0, grossAmount - discount);
        const commissionAmount = (netAmount * repRate) / 100;

        // إرسال الفاتورة لمحرك الـ Store
        const savedInv = store.saveSalesInvoice({
          invNo,
          date,
          profileId: profile.id,
          customer,
          rep,
          type,
          warehouse,
          cashBox,
          grossAmount,
          discount,
          netAmount,
          commissionRate: repRate,
          commissionAmount,
          items: validRows,
          notes,
          chosenStatus: isImmediatePosting ? 'مرحلة' : (sinvStatusVal || (profile.isQuotation ? 'عرض سعر' : 'قيد المراجعة'))
        });

        closeModal();
        renderActiveScreen();

        if (profile.isQuotation) {
          window.showOnyxToast(`تم إصدار وحفظ عرض السعر [${savedInv.invNo}] بنجاح (بدون أثر محاسبي أو مخزني)`, "✔");
        } else if (isImmediatePosting) {
          window.showOnyxToast(`تم حفظ وترحيل فاتورة المبيعات [${savedInv.invNo}] بنجاح للأستاذ العام وخصم المخزون`, "✔");
        } else {
          window.showOnyxToast(`تم حفظ فاتورة المبيعات [${savedInv.invNo}] بنجاح، وهي الآن جاهزة في مركز المراجعة والترحيل`, "✔");
        }
      } catch (err) {
        window.showOnyxToast(err.message, "⚠️");
      }
    },

