    submitStockTransfer: () => {
      const itemCode = document.getElementById('xfer-item-select')?.value;
      const fromWH = document.getElementById('xfer-from-wh')?.value;
      const toWH = document.getElementById('xfer-to-wh')?.value;
      const qty = Number(document.getElementById('xfer-qty')?.value) || 0;
      const note = document.getElementById('xfer-note')?.value.trim();

      if (fromWH === toWH) {
        window.showOnyxToast("لا يمكن التحويل لنفس المستودع!", "⚠️");
        return;
      }
      if (qty <= 0) {
        window.showOnyxToast("يرجى إدخال كمية صحيحة أكبر من الصفر", "⚠️");
        return;
      }

      const item = (store.state.items || []).find(i => i.code === itemCode);
      if (!item) return;

      if (!item.whStock) item.whStock = { WH01: 0, WH02: 0 };
      const currentSourceQty = Number(item.whStock[fromWH] || 0);

      if (currentSourceQty < qty) {
        window.showOnyxToast(`الكمية المتاحة في مستودع المصدر (${currentSourceQty}) أقل من المطلوب تحويله (${qty})!`, "⚠️");
        return;
      }

      item.whStock[fromWH] = currentSourceQty - qty;
      item.whStock[toWH] = Number(item.whStock[toWH] || 0) + qty;
      item.currentStock = (item.whStock.WH01 || 0) + (item.whStock.WH02 || 0);

      store.save();
      window.showOnyxToast(`تم تحويل ${qty} ${item.unit} من صنف [${item.name}] بنجاح`, "✔");
      closeModal();
      renderActiveScreen();
    },

