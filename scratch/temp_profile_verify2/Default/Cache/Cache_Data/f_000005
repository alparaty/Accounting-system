      const d = Number(document.getElementById('pur-disc')?.value) || 0;
      const netEl = document.getElementById('pur-net');
      if (netEl) netEl.value = store.formatCurrency(Math.max(0, g - d));
    },
    submitPurchase: () => {
      const invNo = document.getElementById('pur-inv')?.value.trim();
      const supplier = document.getElementById('pur-supplier')?.value.trim();
      const type = document.getElementById('pur-type')?.value;
      const date = document.getElementById('pur-date')?.value;
      const grossAmount = Number(document.getElementById('pur-gross')?.value) || 0;
      const discountEarned = Number(document.getElementById('pur-disc')?.value) || 0;
      const netAmount = Math.max(0, grossAmount - discountEarned);

      if (!supplier || grossAmount <= 0) {
        window.showOnyxToast("يرجى إدخال اسم المورد ومبلغ صحيح", "⚠️");
        return;
      }
      try {
        store.addPurchaseInvoice({ invNo, supplier, type, date, grossAmount, discountEarned, netAmount });
        window.showOnyxToast(`تم حفظ فاتورة المشتريات رقم [${invNo}] بنجاح`, "✔");
