     التنقل بين الشاشات
     ========================================================================= */
  function openScreen(screenKey) {
    if (!screensInfo[screenKey]) return;
    activeScreen = screenKey;

    document.querySelectorAll('.onyx-tree-item').forEach(el => {
      if (el.dataset.screen === screenKey) {
        el.classList.add('active');
      } else {
        el.classList.remove('active');
      }
    });

    document.querySelectorAll('.onyx-menu-item').forEach(el => {
      if (el.dataset.screen === screenKey) {
        el.classList.add('active');
      } else {
        el.classList.remove('active');
      }
    });

    if (screenTitleEl) screenTitleEl.textContent = screensInfo[screenKey].title;
    if (screenSubEl) screenSubEl.textContent = screensInfo[screenKey].sub;

    renderActiveScreen();
    updateBadges();
  }

  document.querySelectorAll('.onyx-tree-item').forEach(el => {
    el.addEventListener('click', () => {
      openScreen(el.dataset.screen);
    });
  });

  function updateBadges() {
    const pendingJV = (store.state.journalEntries || []).filter(j => j.status === 'DRAFT' || j.status === 'REVIEWED').length;
    const pendingVouchers = (store.state.vouchers || []).filter(v => v.status === 'DRAFT' || v.status === 'REVIEWED').length;
    const pendingSales = (store.state.salesInvoices || []).filter(s => s.status !== 'POSTED' && s.status !== 'مرحلة').length;
    const pendingPurchases = (store.state.purchaseInvoices || []).filter(p => p.status !== 'POSTED' && p.status !== 'مرحل').length;
    const pendingExpenses = (store.state.expenses || []).filter(e => e.status !== 'POSTED' && e.status !== 'مرحل').length;
    const totalPending = pendingJV + pendingVouchers + pendingSales + pendingPurchases + pendingExpenses;

    if (pendingBadgeEl) {
      pendingBadgeEl.textContent = totalPending;
      pendingBadgeEl.style.display = totalPending > 0 ? 'inline-block' : 'none';
    }
  }

