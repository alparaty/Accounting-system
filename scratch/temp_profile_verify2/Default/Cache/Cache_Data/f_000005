    calculateDisposalPreview: () => {
      const amt = Number(document.getElementById('disp-amount')?.value) || 0;
      const type = document.getElementById('disp-type')?.value;
      const previewBox = document.getElementById('disp-preview-box');
      if (!previewBox) return;

      const asset = store.state.fixedAssets.find(a => a.status === 'active');
      const bookVal = asset ? Number(asset.currentBookValue) : 0;
      const actualAmt = (type === 'disposed') ? 0 : amt;
      const diff = actualAmt - bookVal;

      if (diff > 0) {
        previewBox.style.background = '#dcfce7';
        previewBox.style.color = '#15803d';
        previewBox.innerHTML = `الأثر المالي: ربح استبعاد أصل بقيمة +${store.formatCurrency(diff)} (يُرحل للإيرادات غير التشغيلية بقائمة الدخل)`;
      } else if (diff < 0) {
        previewBox.style.background = '#fee2e2';
        previewBox.style.color = '#b91c1c';
        previewBox.innerHTML = `الأثر المالي: خسارة استبعاد أصل بقيمة ${store.formatCurrency(Math.abs(diff))} (يُرحل للمصروفات غير التشغيلية بقائمة الدخل)`;
      } else {
        previewBox.style.background = '#eff6ff';
        previewBox.style.color = '#1e40af';
        previewBox.innerHTML = `الأثر المالي المتوقع: 0.00 ر.ي (لا يوجد ربح أو خسارة استبعاد)`;
      }
    },

