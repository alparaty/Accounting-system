            <div class="onyx-form-group">
              <label class="onyx-label">إجمالي الخصم (Discount)</label>
              <input class="onyx-input num-cell font-bold" id="adapt-discount-total" readonly value="0" style="background:#fff; color:#b45309; font-size:13px;">
