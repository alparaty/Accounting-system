            </div>
            <div class="onyx-form-group">
              <label class="onyx-label">عمولة المندوب (520101)</label>
              <input class="onyx-input num-cell font-bold" id="adapt-comm-total" readonly value="0" style="background:#fff; color:#2563eb; font-size:13px;">
            </div>
            <div class="onyx-form-group">
              <label class="onyx-label">هامش الربح التقديري للفاتورة</label>
              <input class="onyx-input num-cell font-bold" id="adapt-profit-total" readonly value="0" style="background:#fff; color:#7c3aed; font-size:13px;">
            </div>
          </div>

          <!-- ملاحظات الفاتورة -->
          <div style="margin-top:4px;">
