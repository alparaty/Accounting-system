      menu.innerHTML = `
        <div class="context-menu-header">
          <span>أدوات تحرير السطر</span>
          <span style="font-size:9.5px; color:#64748b;">السطر #${rowIndex + 1}</span>
        </div>
        <div class="context-menu-item" onclick="window.onyxApp.contextRowAction('undo', ${rowIndex})">
