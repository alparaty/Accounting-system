    calcAlameenInvoiceTotals: () => {
      const tbody = document.getElementById('alameenActiveInvoiceTbody');
      if (!tbody) return;

      let filledRowsCount = 0;
      let totalQty = 0;
      let subtotal = 0;
      let totalDiscount = 0;
      let totalAdditions = 0;

      Array.from(tbody.querySelectorAll('tr')).forEach(tr => {
        const itemInput = tr.querySelector('.al-cell-item');
        const qtyInput = tr.querySelector('.al-cell-qty');
        const priceInput = tr.querySelector('.al-cell-price');
        const totalCell = tr.querySelector('.al-cell-total');
        const discInput = tr.querySelector('.al-cell-disc');
        const addInput = tr.querySelector('.al-cell-add');

        const itemName = itemInput ? itemInput.value.trim() : '';
        const qty = qtyInput ? Number(qtyInput.value) || 0 : 0;
        const price = priceInput ? Number(priceInput.value) || 0 : 0;
        const disc = discInput ? Number(discInput.value) || 0 : 0;
        const add = addInput ? Number(addInput.value) || 0 : 0;

        if (itemName || qty > 0 || price > 0) {
          filledRowsCount++;
          totalQty += qty;
          const rowTot = (qty * price) - disc + add;
          subtotal += (qty * price);
          totalDiscount += disc;
          totalAdditions += add;

          if (totalCell) totalCell.textContent = rowTot > 0 ? Number(rowTot).toLocaleString() : '';
        } else {
          if (totalCell) totalCell.textContent = '';
        }
      });

      const grandTotal = Math.max(0, subtotal - totalDiscount + totalAdditions);

      // تحديث الإحصائيات
      const statRows = document.getElementById('al-stat-rows-count');
      if (statRows) statRows.textContent = filledRowsCount;

      const statQty = document.getElementById('al-stat-total-qty');
      if (statQty) statQty.textContent = totalQty.toFixed(2);

      // تحديث شريط الإجماليات
      const grandEl = document.getElementById('al-grand-total-display');
      if (grandEl) grandEl.textContent = Number(grandTotal).toLocaleString() + '.00';

      const subEl = document.getElementById('al-subtotal-display');
      if (subEl) subEl.textContent = Number(subtotal).toLocaleString() + '.00';

      const discEl = document.getElementById('al-discount-display');
      if (discEl) discEl.textContent = Number(totalDiscount).toLocaleString() + '.00';

      const addEl = document.getElementById('al-additions-display');
      if (addEl) addEl.textContent = Number(totalAdditions).toLocaleString() + '.00';
    },

