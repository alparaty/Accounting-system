    handleLoginSubmit: (e) => {
      if (e && e.preventDefault) e.preventDefault();

      const year = document.getElementById('login-year')?.value || '2026';
      const userCode = document.getElementById('login-user-code')?.value || '1';
      const password = document.getElementById('login-password')?.value || '';
      const branch = document.getElementById('login-branch')?.value || '01';
      const systemModule = document.getElementById('login-system-module')?.value || '1';
      const modal = document.getElementById('onyxLoginModal');

      const auth = store.authenticate(userCode, password);
      if (!auth.success) {
        if (modal) {
          modal.classList.add('shake');
          setTimeout(() => modal.classList.remove('shake'), 500);
        }
        const passInput = document.getElementById('login-password');
        if (passInput) {
          passInput.style.borderColor = '#ef4444';
          passInput.focus();
          passInput.select();
        }
        window.showOnyxToast(auth.message || "فشل تسجيل الدخول: تحقق من بيانات المستخدم وكلمة السر", "⚠️");
        return;
      }

      const user = auth.user;
      user.assignedBranchId = branch;
      user.uiMode = (systemModule === '2') ? 'BRANCH_HUB' : 'ENTERPRISE';

      if (store.state.system) {
        store.state.system.activeYear = year;
        store.state.system.activeBranch = branch;
      }
      store.save();

      sessionStorage.setItem('onyx_logged_in', 'true');
      const remember = document.getElementById('login-remember-me')?.checked;
      if (remember) {
        localStorage.setItem('onyx_saved_user', userCode);
