  function renderReviewPosting() {
    const pendingJV = (store.state.journalEntries || []).filter(j => j.status === 'DRAFT' || j.status === 'REVIEWED');
    const pendingVouchers = (store.state.vouchers || []).filter(v => v.status === 'DRAFT' || v.status === 'REVIEWED');
    const allSales = store.state.salesInvoices || [];
    const pendingSales = allSales.filter(s => s.status !== 'POSTED' && s.status !== 'مرحلة');
    const allPurchases = store.state.purchaseInvoices || [];
    const pendingPurchases = allPurchases.filter(p => p.status !== 'POSTED' && p.status !== 'مرحل');
    const pendingExpenses = (store.state.expenses || []).filter(e => e.status === 'DRAFT' || e.status === 'REVIEWED');
    const allPOS = store.state.posInvoices || [];

    const totalPending = pendingJV.length + pendingVouchers.length + pendingSales.length + pendingPurchases.length + pendingExpenses.length;
    const reviewedCount = [
      ...pendingJV, ...pendingVouchers, ...pendingSales, ...pendingPurchases, ...pendingExpenses
    ].filter(d => d.status === 'REVIEWED').length;

    // توحيد الوثائق في مصفوفة موحدة للعرض بحسب الفلتر
    let unifiedDocs = [];

    if (activeReviewFilter === 'ALL' || activeReviewFilter === 'JV') {
      pendingJV.forEach(j => unifiedDocs.push({
        rawType: 'JV',
        id: j.id,
        typeLabel: 'قيد يومي عام',
        date: j.date,
        party: j.desc,
        amount: j.lines ? j.lines.reduce((s, l) => s + (l.debit || 0), 0) : (j.totalDebit || 0),
        status: j.status,
        reviewer: j.reviewedBy
      }));
    }

    if (activeReviewFilter === 'ALL' || activeReviewFilter === 'VOUCHERS') {
      pendingVouchers.forEach(v => unifiedDocs.push({
        rawType: 'VOUCHER',
        id: v.id,
        typeLabel: v.type === 'PAYMENT' ? (v.method === 'CHEQUE' ? 'شيك صرف' : 'سند صرف نقدي') : (v.method === 'CHEQUE' ? 'شيك قبض' : 'سند قبض نقدي'),
        date: v.date,
        party: v.targetName || v.targetAcc,
        amount: v.amount,
        status: v.status,
        reviewer: v.reviewedBy
      }));
    }

    if (activeReviewFilter === 'ALL') {
      pendingSales.forEach(s => unifiedDocs.push({
        rawType: 'SALES_INVOICE',
        id: s.invNo || s.id,
        typeLabel: `فاتورة مبيعات (${s.type || 'نقداً'})`,
        date: s.date,
        party: `العميل: ${s.customer || 'عميل عام'} (المندوب: ${s.rep || '-'})`,
        amount: s.netAmount || s.grossAmount || 0,
        status: s.status === 'REVIEWED' ? 'REVIEWED' : 'DRAFT',
        reviewer: s.reviewedBy
      }));
    } else if (activeReviewFilter === 'SALES') {
      allSales.forEach(s => {
        const isPosted = s.status === 'POSTED' || s.status === 'مرحلة';
        const isReviewed = s.status === 'REVIEWED';
        unifiedDocs.push({
          rawType: 'SALES_INVOICE',
          id: s.invNo || s.id,
          typeLabel: `فاتورة مبيعات (${s.type || 'نقداً'})`,
          date: s.date,
          party: `العميل: ${s.customer || 'عميل عام'} (المندوب: ${s.rep || '-'})`,
          amount: s.netAmount || s.grossAmount || 0,
          status: isPosted ? 'POSTED' : (isReviewed ? 'REVIEWED' : 'DRAFT'),
          reviewer: s.reviewedBy,
          poster: s.postedBy
        });
      });
    }

    if (activeReviewFilter === 'POS') {
      allPOS.forEach(p => {
        unifiedDocs.push({
          rawType: 'POS_INVOICE',
          id: p.id,
          typeLabel: `نقطة بيع (${p.paymentMethod === 'CASH' ? 'نقداً' : (p.paymentMethod === 'CARD' ? 'بطاقة/شبكة' : 'آجل')})`,
