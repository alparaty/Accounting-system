  document.addEventListener('keydown', (e) => {
    const invWin = document.getElementById('alameenInvoiceWindow');
    const isInvOpen = invWin && invWin.style.display !== 'none';

    if (e.key === 'Escape') {
      if (isInvOpen) {
        window.onyxApp.closeBranchInvoiceWindow();
        return;
      }
      closeModal();
      return;
    }
    if (e.shiftKey && e.key === 'F8') {
      e.preventDefault();
      if (isInvOpen) {
        window.onyxApp.printAlameenInvoice();
        return;
      }
      window.print();
      return;
    }
    if (e.shiftKey && e.key === 'F9') {
      e.preventDefault();
      window.onyxApp.openShiftClosingModal();
      return;
    }
    if (e.shiftKey && e.key === 'F6') {
      e.preventDefault();
      if (isInvOpen) {
        window.onyxApp.deleteAlameenInvoice();
        return;
      }
      handleShiftF6();
      return;
    }
    if (e.key === 'F6') {
      e.preventDefault();
      if (isInvOpen) {
        window.onyxApp.newAlameenInvoice();
        return;
      }
      handleF6();
      return;
    }
    if (e.key === 'F10') {
      e.preventDefault();
      if (isInvOpen) {
        window.onyxApp.saveAlameenInvoice();
        return;
      }
      handleF10();
      return;
    }
    if (e.key === 'F5') {
      e.preventDefault();
      if (isInvOpen) {
        const curProf = window.onyxApp.currentBranchProfile;
        if (curProf) window.onyxApp.openBranchInvoiceWindow(curProf.id);
        window.showOnyxToast("تم تحديث بيانات الفاتورة [F5]");
