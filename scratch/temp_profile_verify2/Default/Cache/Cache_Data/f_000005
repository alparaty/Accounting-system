    generateAccountStatementHtml: (accCode) => {
      const acc = store.state.accounts.find(a => a.code === accCode);
      if (!acc) return '<div style="padding:15px; color:#64748b;">الحساب غير موجود</div>';

      const rate = store.state.system.exchangeRates[acc.currency] || 1.0;
      const initialInLocal = (acc.balance || 0) * rate;
      const isDebitNature = acc.code.startsWith('1') || acc.code.startsWith('5');
      
      let runningBalance = isDebitNature ? initialInLocal : -initialInLocal;
      let totalDebit = isDebitNature ? initialInLocal : 0;
      let totalCredit = isDebitNature ? 0 : initialInLocal;

      const rows = [];
      // رصيد افتتاحي
      rows.push(`
        <tr style="background:#f8fafc; font-weight:700;">
          <td class="text-center">-</td>
          <td class="num-cell text-center">${store.state.system.startDate || '2024-01-01'}</td>
          <td>رصيد بداية المدة الافتتاحي (Opening Balance)</td>
          <td class="num-cell" style="color:#15803d;">${isDebitNature ? store.formatCurrency(initialInLocal) : '-'}</td>
          <td class="num-cell" style="color:#b91c1c;">${!isDebitNature ? store.formatCurrency(initialInLocal) : '-'}</td>
          <td class="num-cell" style="font-weight:800; color:${runningBalance >= 0 ? '#15803d' : '#b91c1c'};">
            ${store.formatCurrency(Math.abs(runningBalance))} ${runningBalance >= 0 ? '(مدين)' : '(دائن)'}
          </td>
        </tr>
      `);

      // القيود المرحلة
      const postedJournals = store.state.journalEntries.filter(j => j.status === 'POSTED');
      postedJournals.forEach(j => {
        j.lines.filter(l => l.accCode === accCode).forEach(l => {
          totalDebit += (l.debit || 0);
          totalCredit += (l.credit || 0);
          if (isDebitNature) {
            runningBalance += (l.debit || 0) - (l.credit || 0);
          } else {
            runningBalance += (l.credit || 0) - (l.debit || 0);
          }
          rows.push(`
            <tr>
              <td class="text-center" style="font-family:monospace; font-weight:700;"><a href="javascript:void(0)" onclick="window.onyxApp.viewJournal('${j.id}')">${j.id}</a></td>
              <td class="num-cell text-center">${j.date}</td>
              <td>${l.note || j.desc || 'حركة مرحلة'}</td>
              <td class="num-cell" style="color:#15803d;">${l.debit > 0 ? store.formatCurrency(l.debit) : '-'}</td>
              <td class="num-cell" style="color:#b91c1c;">${l.credit > 0 ? store.formatCurrency(l.credit) : '-'}</td>
              <td class="num-cell" style="font-weight:800; color:${runningBalance >= 0 ? '#15803d' : '#b91c1c'};">
                ${store.formatCurrency(Math.abs(runningBalance))} ${runningBalance >= 0 ? '(مدين)' : '(دائن)'}
              </td>
            </tr>
          `);
        });
      });

      return `
        <div style="margin-bottom:10px; display:flex; justify-content:space-between; align-items:center; background:#f1f5f9; padding:8px 12px; border-radius:4px;">
          <div>
            <strong>الحساب:</strong> ${acc.code} - ${acc.name} | <strong>العملة:</strong> ${acc.currency}
          </div>
          <div>
            <strong>الرصيد الختامي الحالي:</strong> 
            <span style="font-weight:900; color:${runningBalance >= 0 ? '#15803d' : '#b91c1c'};">
              ${store.formatCurrency(Math.abs(runningBalance))} ${runningBalance >= 0 ? '(مدين)' : '(دائن)'}
            </span>
          </div>
        </div>
        <div class="onyx-grid-container">
          <table class="onyx-grid">
            <thead>
              <tr>
                <th style="width:110px;">رقم القيد / المستند</th>
                <th style="width:100px;">التاريخ</th>
                <th>البيان والتفاصيل</th>
                <th class="text-left" style="width:130px;">حركة مدين</th>
                <th class="text-left" style="width:130px;">حركة دائن</th>
                <th class="text-left" style="width:150px;">الرصيد التراكمي المتحرك</th>
              </tr>
            </thead>
            <tbody>
              ${rows.join('')}
            </tbody>
            <tfoot>
              <tr style="background:#e2e8f0; font-weight:800;">
                <td colspan="3" class="text-center">إجمالي الحركات</td>
                <td class="num-cell" style="color:#15803d;">${store.formatCurrency(totalDebit)}</td>
                <td class="num-cell" style="color:#b91c1c;">${store.formatCurrency(totalCredit)}</td>
                <td class="num-cell" style="font-weight:900; color:#0f2b5c;">
                  ${store.formatCurrency(Math.abs(runningBalance))} ${runningBalance >= 0 ? '(مدين)' : '(دائن)'}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      `;
    },

