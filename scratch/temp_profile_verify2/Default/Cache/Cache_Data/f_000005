  let modalCloseTimer = null;

  function openModal(title, bodyHtml, footerHtml = '') {
    if (modalCloseTimer) {
      clearTimeout(modalCloseTimer);
      modalCloseTimer = null;
    }
    modalContainer.innerHTML = `
      <div class="onyx-modal-window">
        <div class="onyx-modal-title">
          <span>${title}</span>
          <button class="onyx-modal-close" onclick="window.onyxApp.closeModal()">✕</button>
        </div>
        <div class="onyx-modal-body">${bodyHtml}</div>
        ${footerHtml ? `<div class="onyx-modal-footer">${footerHtml}</div>` : ''}
      </div>
    `;
    // تطبيق ترميز الأرقام والتواريخ الإنجليزية على كل حقول النافذة
    modalContainer.querySelectorAll('input, select, textarea, .num-cell').forEach(el => {
      if (el.type === 'date' || el.type === 'number' || el.classList.contains('num-cell')) {
        el.setAttribute('lang', 'en');
        el.setAttribute('dir', 'ltr');
      }
      el.style.fontFamily = "'Segoe UI', Consolas, Tahoma, Arial, sans-serif";
    });
    modalContainer.classList.add('active');
  }

  function closeModal() {
    modalContainer.classList.remove('active');
    if (modalCloseTimer) {
      clearTimeout(modalCloseTimer);
    }
    modalCloseTimer = setTimeout(() => {
      if (!modalContainer.classList.contains('active')) {
        modalContainer.innerHTML = '';
      }
      modalCloseTimer = null;
    }, 150);
  }

