                const catName = cat ? cat.name : 'غير محدد';
                const statusBadge = e.paymentStatus === 'paid'
                  ? `<span style="background:#dcfce7; color:#15803d; padding:2px 8px; border-radius:10px; font-weight:700; font-size:11px;">✔ مدفوع</span>`
                  : (e.paymentStatus === 'partially_paid'
                    ? `<span style="background:#fef3c7; color:#b45309; padding:2px 8px; border-radius:10px; font-weight:700; font-size:11px;">⏳ جزئي</span>`
                    : `<span style="background:#fee2e2; color:#b91c1c; padding:2px 8px; border-radius:10px; font-weight:700; font-size:11px;">✖ آجل غير مسدد</span>`);

                const sourceLabel = e.paymentSource === 'cash_drawer' ? '💵 درج الكاشير' : (e.paymentSource === 'bank' ? '🏦 بنك' : (e.paymentSource === 'non_cash' ? '⚙️ قيد غير نقدي' : 'تمويل خارجي'));

