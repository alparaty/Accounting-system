          amount: p.netTotal || p.subtotal || 0,
          status: 'POSTED',
          reviewer: p.cashier || 'نظام آلي',
          poster: 'ترحيل لحظي آلي',
          posData: p
        });
      });
    }

    if (activeReviewFilter === 'ALL') {
      pendingPurchases.forEach(p => unifiedDocs.push({
        rawType: 'PURCHASE_INVOICE',
        id: p.invNo || p.id,
        typeLabel: `فاتورة مشتريات (${p.type || 'نقداً'})`,
        date: p.date,
        party: `المورد: ${p.supplier || 'مورد عام'}`,
