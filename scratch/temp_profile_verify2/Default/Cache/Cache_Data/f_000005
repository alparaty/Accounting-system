  function syncSalesExcelTableToStore() {
    const tbody = document.getElementById('sales-excel-tbody');
    if (!tbody) return;
    const rows = tbody.querySelectorAll('tr:not(.total-row)');
    if (rows.length === 0) return;

    const parseNum = (str) => {
      if (!str) return 0;
      return parseFloat(window.toEnglishDigits(str).replace(/,/g, '').replace(/[^\d.-]/g, '')) || 0;
    };

    const synced = [];
    rows.forEach(tr => {
      const invNo = tr.querySelector('[data-col="A"]')?.innerText?.trim();
      if (!invNo) return;
      const customer = tr.querySelector('[data-col="B"]')?.innerText?.trim() || "عميل عام";
      const date = tr.querySelector('[data-col="C"]')?.innerText?.trim() || new Date().toISOString().split('T')[0];
      const rep = tr.querySelector('[data-col="D"]')?.innerText?.trim() || "أحمد خالد العبسي";
      const type = tr.querySelector('[data-col="E"]')?.innerText?.trim() || "نقداً";
      const grossAmount = parseNum(tr.querySelector('[data-col="F"]')?.innerText);
      const discount = parseNum(tr.querySelector('[data-col="G"]')?.innerText);
      const netAmount = Math.max(0, grossAmount - discount);
      const commissionRate = parseNum(tr.querySelector('[data-col="I"]')?.innerText) || 2.5;
      const commissionAmount = (netAmount * commissionRate) / 100;
      const statusText = tr.querySelector('[data-col="K"]')?.innerText?.trim() || "قيد المراجعة";

      const existing = (store.state.salesInvoices || []).find(s => s.invNo === invNo || s.id === invNo);
      synced.push({
        id: invNo,
        invNo,
        customer,
        date,
        rep,
        type,
        grossAmount,
        discount,
        netAmount,
        commissionRate,
        commissionAmount,
        status: existing?.status || (statusText.includes('مرحل') ? 'POSTED' : (statusText.includes('معتمد') ? 'REVIEWED' : 'قيد المراجعة')),
        reviewedBy: existing?.reviewedBy || null,
        postedBy: existing?.postedBy || null
      });
    });

    if (synced.length > 0) {
      store.state.salesInvoices = synced;
      store.save();
    }
  }

  function handleF10() {
    const modalSaveBtn = document.querySelector('.onyx-modal-footer button.btn-save');
    if (modalSaveBtn) {
      modalSaveBtn.click();
