          </div>

          <!-- عناصر التوافقية مع الاختبارات السابقة -->
          <div style="display:none;">
            <input type="number" id="sinv-gross" value="0">
            <input type="number" id="sinv-discount" value="0">
            <input type="number" id="sinv-net" value="0">
            <select id="sinv-status"><option value="قيد المراجعة" selected>قيد المراجعة</option></select>
          </div>
        </div>
      `;

      const modalFooter = `
        <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
          <div style="font-size:11px; color:#64748b; font-weight:700;">
            <span>💡 تلميح: اضغط بالزر الأيمن على أي مادة لاستعلام الأسعار أو نسخ ولصق السطر</span>
          </div>
          <div style="display:flex; gap:8px;">
            <button class="onyx-btn-tool" onclick="window.onyxApp.closeModal()">إلغاء [Esc]</button>
            <button class="onyx-btn-tool btn-save" onclick="window.onyxApp.submitAdaptiveSalesInvoice(false)"><span class="kbd">F10</span> حفظ الفاتورة</button>
            <button id="adapt-btn-immediate-post" class="onyx-btn-tool" style="background:#15803d; color:#fff; border-color:#166534; font-weight:800; display:${currentProfile.isQuotation ? 'none' : 'inline-flex'};" onclick="window.onyxApp.submitAdaptiveSalesInvoice(true)">
              <span>⚡</span> حفظ وترحيل فوري للأستاذ العام
            </button>
          </div>
        </div>
      `;

      openModal(modalTitle, modalBody, modalFooter);

      // تطبيق النمط العريض للنافذة
      const win = document.querySelector('.onyx-modal-window');
      if (win) win.classList.add('modal-wide');

      // رسم أسطر الجدول وحساب الإجماليات
      window.onyxApp.renderAdaptiveInvoiceRowsTable();
      window.onyxApp.onAdaptiveInvoiceGeneralCalc();
    },

    // رسم وتحديث أسطر جدول المواد
    renderAdaptiveInvoiceRowsTable: () => {
      const tbody = document.getElementById('adapt-items-tbody');
      if (!tbody) return;

      const profile = window.onyxApp.currentModalProfile || store.getInvoiceProfiles()[0];
      const items = store.state.items || [];
      const rows = window.onyxApp.adaptiveInvoiceRows || [];

      tbody.innerHTML = rows.map((r, idx) => {
        const lineTotal = Math.max(0, ((Number(r.qty) || 0) * (Number(r.price) || 0)) - (Number(r.discount) || 0));
        return `
          <tr id="adapt-row-${idx}" oncontextmenu="window.onyxApp.handleInvoiceRowContextMenu(event, ${idx}); return false;">
            <td style="text-align:center; font-weight:700; color:#64748b;">${idx + 1}</td>
            <td>
              <select class="onyx-select" id="adapt-row-item-${idx}" style="font-weight:700;" onchange="window.onyxApp.onAdaptiveRowItemChange(${idx}, this.value)">
                <option value="">-- اختر الصنف --</option>
                ${items.map(it => `
                  <option value="${it.code}" ${it.code === r.code ? 'selected' : ''}>
                    ${it.name} (${it.code}) - مخزون: ${it.currentStock || 0}
                  </option>
                `).join('')}
              </select>
            </td>
            <td>
              <input type="number" class="onyx-input num-cell font-bold" id="adapt-row-qty-${idx}" value="${r.qty || 1}" min="1" oninput="window.onyxApp.onAdaptiveRowFieldChange(${idx})">
            </td>
            <td>
              <input class="onyx-input text-center" id="adapt-row-unit-${idx}" readonly value="${r.unit || 'حبة'}" style="background:#f8fafc;">
            </td>
            <td>
              <input type="number" class="onyx-input num-cell font-bold" id="adapt-row-price-${idx}" value="${r.price || 0}" oninput="window.onyxApp.onAdaptiveRowFieldChange(${idx})">
            </td>
            <td>
              <input type="number" class="onyx-input num-cell" id="adapt-row-disc-${idx}" value="${r.discount || 0}" oninput="window.onyxApp.onAdaptiveRowFieldChange(${idx})">
            </td>
            <td class="col-serial" style="display:${profile.enableSerial ? 'table-cell' : 'none'};">
              <input class="onyx-input" id="adapt-row-serial-${idx}" placeholder="IMEI / Serial..." value="${r.serial || ''}" oninput="window.onyxApp.adaptiveInvoiceRows[${idx}].serial = this.value">
            </td>
            <td class="col-gift" style="display:${profile.enableGift ? 'table-cell' : 'none'};">
              <input type="number" class="onyx-input num-cell text-center" id="adapt-row-gift-${idx}" placeholder="0" value="${r.giftQty || 0}" oninput="window.onyxApp.adaptiveInvoiceRows[${idx}].giftQty = Number(this.value) || 0">
            </td>
            <td class="num-cell font-bold" id="adapt-row-total-${idx}" style="color:#15803d; font-size:12px;">
              ${store.formatCurrency(lineTotal)}
            </td>
            <td style="text-align:center;">
              <div style="display:inline-flex; gap:3px;">
                <button type="button" class="onyx-btn-tool" style="height:22px; padding:0 6px; font-weight:800;" onclick="window.onyxApp.handleInvoiceRowContextMenu(event, ${idx})" title="قائمة الأسعار والعمليات (زر أيمن)">⋮</button>
                <button type="button" class="onyx-btn-tool btn-del" style="height:22px; padding:0 6px;" onclick="window.onyxApp.deleteAdaptiveInvoiceRow(${idx})" title="حذف السطر">✕</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    },

    // إضافة سطر جديد في جدول الفاتورة
    addAdaptiveInvoiceRow: () => {
      const items = store.state.items || [];
      const profile = window.onyxApp.currentModalProfile || store.getInvoiceProfiles()[0];
      const defaultItem = items[0] || null;

      const newRow = {
        code: defaultItem ? defaultItem.code : '',
        name: defaultItem ? defaultItem.name : '',
        unit: defaultItem ? defaultItem.unit : 'حبة',
        qty: 1,
        price: defaultItem ? (profile.pricingType === 'wholesale' ? (defaultItem.wholesalePrice || defaultItem.salePrice) : defaultItem.salePrice) : 0,
        discount: 0,
        serial: 'SN-' + Math.floor(100000 + Math.random() * 900000),
        giftQty: 0,
        note: ''
      };

      window.onyxApp.syncAdaptiveRowsFromDOM();
      window.onyxApp.adaptiveInvoiceRows.push(newRow);
      window.onyxApp.renderAdaptiveInvoiceRowsTable();
      window.onyxApp.onAdaptiveInvoiceGeneralCalc();
    },

    // حذف سطر من جدول الفاتورة
    deleteAdaptiveInvoiceRow: (rowIndex) => {
      window.onyxApp.syncAdaptiveRowsFromDOM();
      if (window.onyxApp.adaptiveInvoiceRows.length <= 1) {
        window.onyxApp.adaptiveInvoiceRows = [
          { code: '', name: '', unit: 'حبة', qty: 1, price: 0, discount: 0, serial: '', giftQty: 0, note: '' }
        ];
      } else {
        window.onyxApp.adaptiveInvoiceRows.splice(rowIndex, 1);
      }
      window.onyxApp.renderAdaptiveInvoiceRowsTable();
      window.onyxApp.onAdaptiveInvoiceGeneralCalc();
    },

    // مزامنة حالة الأسطر مع قيم الحقول في الـ DOM
    syncAdaptiveRowsFromDOM: () => {
      const rows = window.onyxApp.adaptiveInvoiceRows || [];
      rows.forEach((r, idx) => {
        const itemSelect = document.getElementById(`adapt-row-item-${idx}`);
        const qtyInput = document.getElementById(`adapt-row-qty-${idx}`);
        const unitInput = document.getElementById(`adapt-row-unit-${idx}`);
        const priceInput = document.getElementById(`adapt-row-price-${idx}`);
        const discInput = document.getElementById(`adapt-row-disc-${idx}`);
        const serialInput = document.getElementById(`adapt-row-serial-${idx}`);
        const giftInput = document.getElementById(`adapt-row-gift-${idx}`);

        if (itemSelect) {
          r.code = itemSelect.value;
          const itmObj = (store.state.items || []).find(i => i.code === r.code);
          r.name = itmObj ? itmObj.name : r.code;
        }
        if (qtyInput) r.qty = Number(qtyInput.value) || 1;
        if (unitInput) r.unit = unitInput.value || 'حبة';
        if (priceInput) r.price = Number(priceInput.value) || 0;
        if (discInput) r.discount = Number(discInput.value) || 0;
        if (serialInput) r.serial = serialInput.value || '';
        if (giftInput) r.giftQty = Number(giftInput.value) || 0;
      });
    },

    // عند تغيير الصنف المختار في سطر الفاتورة
    onAdaptiveRowItemChange: (rowIndex, itemCode) => {
      const item = (store.state.items || []).find(i => i.code === itemCode);
      const profile = window.onyxApp.currentModalProfile || store.getInvoiceProfiles()[0];

      if (window.onyxApp.adaptiveInvoiceRows[rowIndex]) {
        const r = window.onyxApp.adaptiveInvoiceRows[rowIndex];
        r.code = itemCode;
        r.name = item ? item.name : '';
        r.unit = item ? item.unit : 'حبة';
        r.price = item ? (profile.pricingType === 'wholesale' ? (item.wholesalePrice || item.salePrice) : item.salePrice) : 0;
        r.costPrice = item ? item.costPrice : 0;
      }

      const unitEl = document.getElementById(`adapt-row-unit-${rowIndex}`);
      const priceEl = document.getElementById(`adapt-row-price-${rowIndex}`);
      if (unitEl && item) unitEl.value = item.unit || 'حبة';
      if (priceEl && item) priceEl.value = profile.pricingType === 'wholesale' ? (item.wholesalePrice || item.salePrice) : item.salePrice;

      window.onyxApp.recalculateAdaptiveInvoiceRow(rowIndex);
      window.onyxApp.onAdaptiveInvoiceGeneralCalc();
    },

    // عند تغيير الكمية أو السعر أو الخصم لسطر
    onAdaptiveRowFieldChange: (rowIndex) => {
      window.onyxApp.recalculateAdaptiveInvoiceRow(rowIndex);
      window.onyxApp.onAdaptiveInvoiceGeneralCalc();
    },

    recalculateAdaptiveInvoiceRow: (rowIndex) => {
      const qty = parseFloat(document.getElementById(`adapt-row-qty-${rowIndex}`)?.value) || 0;
      const price = parseFloat(document.getElementById(`adapt-row-price-${rowIndex}`)?.value) || 0;
      const disc = parseFloat(document.getElementById(`adapt-row-disc-${rowIndex}`)?.value) || 0;
      const total = Math.max(0, (qty * price) - disc);

      if (window.onyxApp.adaptiveInvoiceRows[rowIndex]) {
        window.onyxApp.adaptiveInvoiceRows[rowIndex].qty = qty;
        window.onyxApp.adaptiveInvoiceRows[rowIndex].price = price;
        window.onyxApp.adaptiveInvoiceRows[rowIndex].discount = disc;
        window.onyxApp.adaptiveInvoiceRows[rowIndex].total = total;
      }

      const totalEl = document.getElementById(`adapt-row-total-${rowIndex}`);
      if (totalEl) totalEl.textContent = store.formatCurrency(total);
    },

    // احتساب مجاميع الفاتورة والهوامش
    onAdaptiveInvoiceGeneralCalc: () => {
      window.onyxApp.syncAdaptiveRowsFromDOM();
      const rows = window.onyxApp.adaptiveInvoiceRows || [];

      let gross = 0;
      let totalDiscount = 0;
      let totalCost = 0;

      rows.forEach(r => {
        const q = Number(r.qty) || 0;
        const p = Number(r.price) || 0;
        const d = Number(r.discount) || 0;
        gross += (q * p);
        totalDiscount += d;

        const itmObj = (store.state.items || []).find(i => i.code === r.code);
        const unitCost = Number(itmObj?.costPrice) || 0;
        totalCost += (q * unitCost);
      });

      // توافقية مع الاختبارات الآلية
      const sinvGrossInput = document.getElementById('sinv-gross');
      const sinvDiscountInput = document.getElementById('sinv-discount');
      const sinvNetInput = document.getElementById('sinv-net');
      if (sinvGrossInput && Number(sinvGrossInput.value) > 0) {
        gross = Number(sinvGrossInput.value);
      }
      if (sinvDiscountInput && Number(sinvDiscountInput.value) > 0) {
        totalDiscount = Number(sinvDiscountInput.value);
      }
      if (sinvNetInput) {
        sinvNetInput.value = Math.max(0, gross - totalDiscount);
      }

      const net = Math.max(0, gross - totalDiscount);

      const repSelect = document.getElementById('adapt-inv-rep');
      const selectedOption = repSelect?.options[repSelect.selectedIndex];
      const repRate = parseFloat(selectedOption?.dataset?.rate) || 2.5;
      const commAmt = (net * repRate) / 100;
      const grossProfit = Math.max(0, net - totalCost);

      const grossEl = document.getElementById('adapt-gross-total');
      const discEl = document.getElementById('adapt-discount-total');
      const netEl = document.getElementById('adapt-net-total');
      const commEl = document.getElementById('adapt-comm-total');
      const profitEl = document.getElementById('adapt-profit-total');

      if (grossEl) grossEl.value = store.formatCurrency(gross);
      if (discEl) discEl.value = store.formatCurrency(totalDiscount);
      if (netEl) netEl.value = store.formatCurrency(net);
      if (commEl) commEl.value = store.formatCurrency(commAmt);
      if (profitEl) profitEl.value = `${store.formatCurrency(grossProfit)} (${gross > 0 ? ((grossProfit / net) * 100).toFixed(1) : 0}%)`;
    },

    onAdaptiveCustomerChange: () => {
      window.onyxApp.onAdaptiveInvoiceGeneralCalc();
    },

    onAdaptiveInvoiceTypeChange: (typeVal) => {
      const postBtn = document.getElementById('adapt-btn-immediate-post');
      if (postBtn) {
        postBtn.style.display = (typeVal === 'عرض سعر') ? 'none' : 'inline-flex';
      }
    },

    // تبديل النمط النشط ديناميكياً داخل شاشة الفاتورة
    switchAdaptiveProfile: (newProfileId) => {
      const newProfile = store.getInvoiceProfile(newProfileId);
      if (!newProfile) return;

      window.onyxApp.currentModalProfile = newProfile;
      window.onyxApp.syncAdaptiveRowsFromDOM();

      // 1. تحديث لون وهوية الشريط العلوي
      const banner = document.getElementById('adapt-theme-banner');
      const titleEl = document.getElementById('adapt-banner-title');
      const descEl = document.getElementById('adapt-banner-desc');
      if (banner) {
        banner.style.background = newProfile.themeColor;
        banner.style.color = newProfile.textColor || '#0f2b5c';
      }
      if (titleEl) titleEl.textContent = `نمط الفاتورة النشط: ${newProfile.name}`;
      if (descEl) descEl.textContent = newProfile.description || 'محرك الأنماط الديناميكي لنظام البرطي المالي الشامل';

      // 2. تحديث ترويسة الجدول بالألوان
      const ths = document.querySelectorAll('#adapt-table-header-tr th');
      ths.forEach(th => {
        th.style.background = newProfile.themeColor;
        th.style.color = newProfile.textColor || '#0f2b5c';
      });

      // 3. إظهار أو إخفاء عمود السيريال وعمود الهدايا
      const serialCols = document.querySelectorAll('.col-serial');
      serialCols.forEach(col => {
        col.style.display = newProfile.enableSerial ? 'table-cell' : 'none';
      });

      const giftCols = document.querySelectorAll('.col-gift');
      giftCols.forEach(col => {
        col.style.display = newProfile.enableGift ? 'table-cell' : 'none';
      });

      // 4. تحديث تنبيه عرض السعر
      const quoteNotice = document.getElementById('adapt-quotation-notice');
      if (quoteNotice) {
        quoteNotice.style.display = newProfile.isQuotation ? 'flex' : 'none';
      }

      // 5. تحديث طريقة السداد والعميل
      const typeSelect = document.getElementById('adapt-inv-type');
      if (typeSelect) {
        if (newProfile.isQuotation) typeSelect.value = 'عرض سعر';
        else if (newProfile.paymentType) typeSelect.value = newProfile.paymentType;
      }

      const reqMark = document.getElementById('adapt-cust-required-mark');
      if (reqMark) {
        reqMark.style.display = newProfile.requireCustomer ? 'inline' : 'none';
      }

      const postBtn = document.getElementById('adapt-btn-immediate-post');
      if (postBtn) {
        postBtn.style.display = newProfile.isQuotation ? 'none' : 'inline-flex';
      }

      // 6. تحديث الأسعار بحسب نوع التسعير (جملة / تجزئة)
      if (newProfile.pricingType === 'wholesale') {
        window.onyxApp.adaptiveInvoiceRows.forEach((r, idx) => {
          const itm = (store.state.items || []).find(i => i.code === r.code);
          if (itm && itm.wholesalePrice) {
            r.price = itm.wholesalePrice;
            const priceEl = document.getElementById(`adapt-row-price-${idx}`);
            if (priceEl) priceEl.value = itm.wholesalePrice;
          }
        });
      }

      window.onyxApp.renderAdaptiveInvoiceRowsTable();
      window.onyxApp.onAdaptiveInvoiceGeneralCalc();
      window.showOnyxToast(`تم تكييف الفاتورة وفق نمط [${newProfile.name}] بنجاح`, "🎨");
    },

    // معالجة النقر بالزر الأيمن على سطر المادة (Right-Click Context Menu)
    handleInvoiceRowContextMenu: (event, rowIndex) => {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }

      // تظليل السطر المحدد
      document.querySelectorAll('#adapt-items-tbody tr').forEach(tr => tr.classList.remove('row-selected'));
      const activeTr = document.getElementById(`adapt-row-${rowIndex}`);
      if (activeTr) activeTr.classList.add('row-selected');

      window.onyxApp.syncAdaptiveRowsFromDOM();
      const row = window.onyxApp.adaptiveInvoiceRows[rowIndex];
      const itemCode = row?.code || '';
      const customer = document.getElementById('adapt-inv-customer')?.value || '';

      // حفظ نسخة احتياطية للتراجع
      if (row) {
        window.onyxApp.invoiceRowHistory[rowIndex] = JSON.parse(JSON.stringify(row));
      }

      // استعلام تحليلات وتاريخ الأسعار من الـ Store
      const hist = store.getItemPriceHistory(itemCode, customer);

      // إزالة أي قائمة سابقة
      const oldMenu = document.getElementById('onyx-adaptive-context-menu');
