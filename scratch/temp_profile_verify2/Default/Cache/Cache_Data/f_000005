  function renderExpensesTabContent() {
    switch (expensesActiveTab) {
      case 'exp_log':
        return renderExpensesLogTab();
      case 'exp_due':
        return renderExpensesDueTab();
      case 'exp_recurring':
        return renderExpensesRecurringTab();
      case 'exp_payroll':
        return renderExpensesPayrollTab();
      case 'exp_assets':
        return renderExpensesAssetsTab();
      case 'exp_categories':
        return renderExpensesCategoriesTab();
      case 'exp_reports':
        return renderExpensesReportsTab();
      default:
        return renderExpensesLogTab();
    }
  }

  // 1. تبويب سجل وقيد المصروفات
  function renderExpensesLogTab() {
    const allExp = store.state.expenses || [];
    const categories = store.getExpenseCategories(false);

    // حساب المؤشرات
    const totalExp = allExp.reduce((s, e) => s + (Number(e.totalAmount) || 0), 0);
    const cashExp = allExp.filter(e => e.paymentSource === 'cash_drawer').reduce((s, e) => s + (Number(e.paidAmount) || 0), 0);
    const bankExp = allExp.filter(e => e.paymentSource === 'bank').reduce((s, e) => s + (Number(e.paidAmount) || 0), 0);
    const dueExp = allExp.filter(e => e.paymentStatus === 'unpaid' || e.paymentStatus === 'partially_paid').reduce((s, e) => s + (Number(e.totalAmount) - Number(e.paidAmount || 0)), 0);

    // تطبيق الفلاتر
