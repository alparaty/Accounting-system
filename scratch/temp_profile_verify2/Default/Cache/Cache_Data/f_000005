// فرض تنسيق الأرقام بالإنجليزية (Western Arabic 0-9) في كامل النظام
(function() {
  const origNumberToLocaleString = Number.prototype.toLocaleString;
  Number.prototype.toLocaleString = function(locales, options) {
    return origNumberToLocaleString.call(this, 'en-US', options);
  };
})();

// دالة مساعدة لتحويل أي أرقام شرقية/عربية إلى أرقام إنجليزية (0-9)
function toEnglishDigits(str) {
  if (str === null || str === undefined) return '';
  const arabicDigits = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
  return String(str).replace(/[٠-٩]/g, d => arabicDigits.indexOf(d));
}

// تحويل أي أرقام مشرقية يتم إدخالها أو لصقها في أي حقل إلى أرقام إنجليزية فوراً
document.addEventListener('input', (e) => {
  if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) {
    const arabicDigits = /[٠١٢٣٤٥٦٧٨٩]/g;
    const map = {'٠':'0','١':'1','٢':'2','٣':'3','٤':'4','٥':'5','٦':'6','٧':'7','٨':'8','٩':'9'};
    if (e.target.value && arabicDigits.test(e.target.value)) {
      e.target.value = e.target.value.replace(arabicDigits, d => map[d]);
    }
  }
}, true);

