  function initExcelGridListeners() {
    const cells = document.querySelectorAll('#excel-main-table td.excel-cell');
    const coordBox = document.getElementById('excel-coord-box');
    const fxInput = document.getElementById('excel-fx-input');

    cells.forEach(cell => {
      cell.addEventListener('click', () => {
        cells.forEach(c => c.classList.remove('selected'));
        cell.classList.add('selected');
        selectedExcelCell = cell;

        const col = cell.dataset.col;
        const row = cell.dataset.row;
        if (coordBox) coordBox.textContent = `${col}${row}`;
        if (fxInput) fxInput.value = cell.textContent.trim();
      });

      cell.addEventListener('input', () => {
        if (fxInput && cell === selectedExcelCell) {
          fxInput.value = cell.textContent.trim();
        }
        recalculateExcelTotals();
      });

      cell.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const nextRow = Number(cell.dataset.row) + 1;
          const col = cell.dataset.col;
          const nextCell = document.querySelector(`td.excel-cell[data-col="${col}"][data-row="${nextRow}"]`);
          if (nextCell) {
            nextCell.focus();
            nextCell.click();
          }
        }
      });
    });

    const firstCell = document.querySelector('td.excel-cell[data-col="A"][data-row="1"]');
    if (firstCell) firstCell.click();
  }

  function recalculateExcelTotals() {
    const staffCells = document.querySelectorAll('td.excel-cell[data-col="E"]');
    const budgetCells = document.querySelectorAll('td.excel-cell[data-col="F"]');

    let sumStaff = 0;
    staffCells.forEach(c => {
      const val = parseFloat(c.textContent.replace(/,/g, '').trim()) || 0;
      sumStaff += val;
    });

    let sumBudget = 0;
    budgetCells.forEach(c => {
      const val = parseFloat(c.textContent.replace(/,/g, '').trim()) || 0;
      sumBudget += val;
    });

    const totalStaffEl = document.getElementById('excel-total-staff');
    const totalBudgetEl = document.getElementById('excel-total-budget');
    if (totalStaffEl) totalStaffEl.textContent = sumStaff;
    if (totalBudgetEl) totalBudgetEl.textContent = `${sumBudget.toLocaleString()} ر.ي`;
  }

