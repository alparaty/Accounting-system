/* ==========================================================================
   نافذة تسجيل الدخول المتطورة الشاملة (Onyx Pro Advanced ERP Login Window)
   مستوحاة من واجهة أونكس برو القياسية مع لمسات عصرية فاخرة وأداء عالٍ
   ========================================================================== */
.onyx-login-overlay {
  position: fixed;
  inset: 0;
  background: radial-gradient(circle at 50% 30%, rgba(15, 43, 92, 0.95), rgba(7, 18, 41, 0.98)),
              linear-gradient(135deg, rgba(2, 132, 199, 0.15) 0%, rgba(15, 23, 42, 0.8) 100%);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 999999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: onyxLoginFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
  user-select: none;
}

@keyframes onyxLoginFadeIn {
  from { opacity: 0; transform: scale(1.02); }
  to { opacity: 1; transform: scale(1); }
}

.onyx-login-modal {
  width: 100%;
  max-width: 530px;
  background: #f8fafc;
  border: 1px solid #94a3b8;
  border-radius: 8px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s;
}

.onyx-login-modal.shake {
  animation: onyxLoginShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
}

@keyframes onyxLoginShake {
  10%, 90% { transform: translate3d(-3px, 0, 0); }
  20%, 80% { transform: translate3d(5px, 0, 0); }
  30%, 50%, 70% { transform: translate3d(-5px, 0, 0); }
  40%, 60% { transform: translate3d(5px, 0, 0); }
}

/* الرأس والشريط العلوي */
.onyx-login-header {
  background: linear-gradient(180deg, #1e3a8a 0%, #0f2b5c 100%);
  color: #ffffff;
  padding: 12px 18px;
  border-bottom: 2px solid #0284c7;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.onyx-login-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.onyx-login-brand-icon {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.onyx-login-brand-title {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.3px;
  color: #ffffff;
}

.onyx-login-brand-sub {
  font-size: 11px;
  color: #93c5fd;
  margin-top: 2px;
}

.onyx-login-status-chip {
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid #10b981;
  color: #6ee7b7;
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 12px;
  font-weight: bold;
  display: flex;
  align-items: center;
  gap: 5px;
}

.onyx-login-pulse-dot {
  width: 6px;
  height: 6px;
  background-color: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 6px #10b981;
  animation: onyxPulse 1.8s infinite;
}

@keyframes onyxPulse {
  0% { transform: scale(0.9); opacity: 0.8; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.8; }
}

/* بطاقات الاختيار السريع */
.onyx-login-presets-bar {
  background: #f1f5f9;
  border-bottom: 1px solid #cbd5e1;
  padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  overflow-x: auto;
}

.onyx-login-presets-label {
  font-size: 11px;
  font-weight: bold;
  color: #475569;
  white-space: nowrap;
}

.onyx-login-preset-chip {
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 4px;
  padding: 3px 10px;
  font-size: 11px;
  color: #1e293b;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: all 0.15s ease;
  font-weight: 600;
  white-space: nowrap;
}

.onyx-login-preset-chip:hover {
  background: #e0f2fe;
  border-color: #0284c7;
  color: #0369a1;
  transform: translateY(-1px);
}

.onyx-login-preset-chip.active {
  background: #0284c7;
  border-color: #0369a1;
  color: #ffffff;
}

/* شبكة الحقول الرئيسية */
.onyx-login-body {
  padding: 14px 20px 10px 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.onyx-login-form-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 5px;
}

.onyx-login-form-table tr {
  vertical-align: middle;
}

.onyx-login-table-label {
  width: 130px;
  padding-left: 14px;
  text-align: right;
  font-size: 12.5px;
  font-weight: 700;
  color: #1e293b;
  white-space: nowrap;
}

.onyx-login-table-control {
  position: relative;
}

.onyx-login-input,
.onyx-login-select {
  width: 100%;
  height: 31px;
  padding: 4px 10px;
  font-size: 12px;
  color: #0f172a;
  background-color: #ffffff;
  border: 1px solid #94a3b8;
  border-radius: 3px;
  outline: none;
  font-family: inherit;
  transition: border-color 0.15s, box-shadow 0.15s;
  box-sizing: border-box;
}

.onyx-login-input:focus,
.onyx-login-select:focus {
  border-color: #0284c7;
  box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.25);
  background-color: #f0f9ff;
}

.onyx-login-select {
  cursor: pointer;
}

.onyx-login-password-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.onyx-login-toggle-pass {
  position: absolute;
  left: 6px;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 14px;
  color: #64748b;
  padding: 2px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.onyx-login-toggle-pass:hover {
  color: #0f172a;
}

.onyx-login-caps-alert {
  display: none;
  position: absolute;
  top: 100%;
