/* مساحة سطح المكتب MDI (اللون الطبيعي الأبيض النقي مثل السابق تماماً) */
.alameen-desktop-workspace {
  flex: 1;
  background: #ffffff;
  position: relative;
  overflow: hidden;
  padding: 0;
  display: flex;
  flex-direction: column;
}

/* اللوحة الجانبية اليمنى (Right Sidebar) */
.alameen-right-sidebar {
  width: 160px;
  background: #eef2f7;
  border-right: 1px solid #cbd5e1;
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
  overflow-y: auto;
  z-index: 10;
