.theme-purple tr:nth-child(even) td:not(.col-gift) {
  background-color: #f3e8ff;
}
.theme-purple tr:nth-child(odd) td:not(.col-gift) {
  background-color: #ffffff;
}

/* جدول الحسابات والإضافات والخصومات الأخضر الثانوي (Secondary Grid) */
.alameen-sub-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 10.5px;
  margin-top: 4px;
}

.alameen-sub-table th {
  background: #f1f5f9;
  color: #334155;
  border: 1px solid #cbd5e1;
  padding: 3px 4px;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
}

.alameen-sub-table td {
  border: 1px solid #cbd5e1;
  padding: 2px 4px;
  height: 20px;
}

.alameen-sub-table tr:nth-child(even) td {
  background-color: #bbf7d0;
}
.alameen-sub-table tr:nth-child(odd) td {
  background-color: #ffffff;
}

/* منطقة الإحصائيات الجانبية وشريط المجاميع وأزرار العمليات (ثابتة دائماً في القاع دون الحاجة للتمرير) */
.alameen-inv-bottom-section {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.alameen-stats-and-subgrid {
  display: flex;
  align-items: flex-end;
  gap: 12px;
}

.alameen-left-counters {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.al-counter-box {
  border: 1px solid #cbd5e1;
  background: #ffffff;
  padding: 4px 10px;
  text-align: center;
  min-width: 65px;
}

.al-counter-val {
  font-size: 14px;
  font-weight: 800;
  color: #1e293b;
}

.al-counter-label {
  font-size: 10px;
  color: #64748b;
  margin-top: 2px;
}

/* شريط الإجماليات الأزرق الناصع */
.alameen-totals-summary-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  padding: 4px;
}

.alameen-grand-total-banner {
  background: #0284c7;
  color: #ffffff;
  padding: 4px 20px;
  display: flex;
  align-items: baseline;
  gap: 12px;
  border-radius: 2px;
  min-width: 220px;
}

.al-grand-label {
  font-size: 13px;
  font-weight: bold;
}

.al-grand-val {
  font-size: 22px;
  font-weight: 900;
  font-family: monospace;
}

.alameen-totals-boxes {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-right: auto;
}

.al-tot-box {
  background: #64748b;
  color: #ffffff;
  padding: 4px 12px;
  text-align: center;
  border-radius: 2px;
  min-width: 75px;
}

.al-tot-box-val {
  font-size: 12px;
  font-weight: 800;
  font-family: monospace;
}

.al-tot-box-lbl {
  font-size: 9.5px;
  color: #f1f5f9;
}

/* شريط أزرار العمليات السفلي (Bottom Action Bar) - ثابت دائماً في قاع النافذة */
.alameen-window-actionbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 6px;
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: 2px;
  flex-wrap: wrap;
  gap: 4px;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.al-act-group {
  display: flex;
  align-items: center;
  gap: 3px;
}

.al-act-btn {
  height: 24px;
  padding: 0 10px;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 2px;
  font-size: 11px;
  font-weight: 600;
  color: #1e293b;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: all 0.1s;
}

.al-act-btn:hover {
  background: #e2e8f0;
  border-color: #94a3b8;
}

.al-act-btn.al-btn-save {
  background: #f0fdf4;
  border-color: #86efac;
  color: #15803d;
  font-weight: 700;
}

.al-act-btn.al-btn-save:hover {
  background: #dcfce7;
  border-color: #4ade80;
  color: #166534;
}

.al-act-btn.al-btn-close {
  color: #dc2626;
  border-color: #fca5a5;
  background: #fef2f2;
}

.al-act-btn.al-btn-close:hover {
  background: #fee2e2;
}

.al-act-dropdown {
  position: relative;
  display: inline-block;
}

/* اللوحة الجانبية اليمنى (Right Sidebar: تحذيرات) */
.alameen-right-sidebar {
  width: 140px;
  background: #f1f5f9;
  border-right: 1px solid #cbd5e1;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  transition: width 0.2s;
}

.alameen-warnings-tab-header {
  background: #0f2b5c;
  color: #ffffff;
  padding: 4px 6px;
  font-size: 11.5px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.al-pin-btn {
  background: transparent;
  border: none;
  color: #ffffff;
  cursor: pointer;
  font-size: 10px;
  padding: 0;
}

.alameen-warnings-content {
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  overflow-y: auto;
  font-size: 10.5px;
}

.al-warning-item {
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 2px;
  padding: 5px;
  display: flex;
  align-items: flex-start;
  gap: 4px;
}

.al-warn-icon {
  font-size: 12px;
  flex-shrink: 0;
}

.al-warn-text {
  font-size: 10px;
  color: #334155;
  line-height: 1.35;
}

/* 4. شريط الحالة السفلي (Statusbar) */
.alameen-statusbar {
  height: 24px;
  background: #e2e8f0;
  border-top: 1px solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  font-size: 11px;
  color: #334155;
  flex-shrink: 0;
}

.alameen-status-left {
  display: flex;
  align-items: center;
  gap: 4px;
}

.al-status-kbd {
  padding: 1px 6px;
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  border-radius: 2px;
  font-size: 10px;
  font-weight: bold;
  color: #64748b;
}

.al-status-kbd.active {
  background: #bfdbfe;
  color: #1e40af;
  border-color: #93c5fd;
}

.alameen-status-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.alameen-status-info {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  color: #1e3a8a;
}

.al-stat-sep {
  color: #94a3b8;
}

.alameen-status-nav-icons {
  display: flex;
  align-items: center;
  gap: 6px;
}

.al-nav-ico {
  cursor: pointer;
  font-size: 12px;
  color: #475569;
}

.al-nav-ico:hover {
  color: #0284c7;
}




