  background-color: #e0e7ff;
}
.theme-lavender tr:nth-child(odd) td:not(.col-gift) {
  background-color: #ffffff;
}

/* مبيعات آجل - أخضر نعناعي */
.theme-mint tr:nth-child(even) td:not(.col-gift) {
  background-color: #a7f3d0;
}
.theme-mint tr:nth-child(odd) td:not(.col-gift) {
  background-color: #ffffff;
}

/* مبيعات اكسسوارات - وردي سلمون */
.theme-pink tr:nth-child(even) td:not(.col-gift) {
