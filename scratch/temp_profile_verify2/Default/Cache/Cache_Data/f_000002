  background: #f8fafc;
}

.context-menu-price-row.profit-row:hover {
  background: #f8fafc;
  border-color: transparent;
}

.context-menu-price-row .profit-badge {
  font-weight: 800;
  color: #15803d;
  background: #dcfce7;
  padding: 2px 7px;
  border-radius: 4px;
  font-size: 11px;
}

