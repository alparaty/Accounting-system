.alameen-cal-time-period {
  font-size: 13px;
  font-weight: 900;
  color: #701a75;
}

/* بطاقة الدعم الفني */
.alameen-support-card {
  background: #e2e8f0;
  border: 1px solid #cbd5e1;
  border-radius: 3px;
  padding: 6px;
  text-align: center;
}

.alameen-support-title {
  font-size: 11px;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 4px;
}

.alameen-support-desc {
  font-size: 9.5px;
  color: #334155;
  line-height: 1.45;
  margin: 0;
}

/* بطاقة الترخيص */
.alameen-license-card {
  background: #e0f2fe;
  border: 1px solid #bae6fd;
  border-radius: 3px;
  padding: 4px;
  text-align: center;
  margin-top: auto;
}

.alameen-license-label {
  font-size: 9.5px;
  color: #0369a1;
  font-weight: bold;
  margin-bottom: 3px;
}

.alameen-license-name {
  background: #034870;
  color: #ffffff;
  font-size: 10.5px;
  font-weight: 800;
  padding: 4px 2px;
  border-radius: 2px;
