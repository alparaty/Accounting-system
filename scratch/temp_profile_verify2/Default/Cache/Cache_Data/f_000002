}

/* ==========================================================================
   قائمة الزر الأيمن لجدول المواد (Right-Click Context Menu)
   ========================================================================== */
.context-menu-dropdown {
  position: fixed;
  z-index: 100000;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22), 0 2px 6px rgba(0,0,0,0.08);
  min-width: 270px;
  max-width: 330px;
  padding: 6px 0;
  font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
  animation: onyxCtxPop 0.12s ease-out;
  user-select: none;
}

@keyframes onyxCtxPop {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

.context-menu-header {
  padding: 5px 12px 3px;
  font-size: 10.5px;
  font-weight: 800;
  color: #64748b;
  letter-spacing: 0.3px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.context-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 12px;
  font-size: 11.5px;
  font-weight: 600;
  color: #1e293b;
  cursor: pointer;
  transition: background 0.12s;
}

.context-menu-item:hover {
  background: #f1f5f9;
  color: #0f2b5c;
}

.context-menu-item.danger:hover {
  background: #fef2f2;
  color: #b91c1c;
}

.context-menu-item .ctx-icon {
  width: 18px;
  display: inline-block;
  text-align: center;
  margin-left: 6px;
}

.context-menu-item .ctx-kbd {
  font-size: 9.5px;
  font-weight: 700;
  color: #94a3b8;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 3px;
  padding: 1px 4px;
}

.context-menu-divider {
  height: 1px;
  background: #e2e8f0;
  margin: 4px 0;
}

.context-menu-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 12px;
  font-size: 11.5px;
  cursor: pointer;
  transition: all 0.12s;
  border-radius: 2px;
  margin: 1px 4px;
}

.context-menu-price-row:hover {
  background: #eff6ff;
  border: 1px solid #bfdbfe;
}

.context-menu-price-row .price-label {
  color: #334155;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}

.context-menu-price-row .price-badge {
  font-weight: 800;
  color: #1d4ed8;
  background: #dbeafe;
  padding: 2px 7px;
  border-radius: 4px;
  font-size: 11px;
  direction: ltr;
}

.context-menu-price-row.profit-row {
