<!DOCTYPE html>
<html lang="ar" dir="rtl" style="background-color:#eef2f7;">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>البرطي المالي الشامل | Al-ParatY Financial Enterprise</title>

  <style>
    /* لون خلفية نافذة البرنامج الأصلي المتناسق مع أونكس برو لمنع الشاشة الزرقاء أو البيضاء */
    html,
    body {
      background-color: #eef2f7 !important;
      margin: 0;
      padding: 0;
    }
  </style>

  <!-- CSS Stylesheet - Classic Onyx Pro Ultra-Clear Theme -->
  <link rel="stylesheet" href="css/onyx_style.css?v=20261003">
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏢</text></svg>">
</head>

<body style="background-color:#eef2f7;">

  <!-- 1. حاوية المركز الرئيسي (واجهة أونكس برو الكلاسيكية الحالية) -->
  <div id="enterprise-app-container" class="onyx-app-wrapper">

    <!-- 1. Onyx Titlebar (شريط عنوان النظام) -->
    <header class="onyx-titlebar">
      <div class="onyx-title-left">
        <span class="onyx-system-badge">AL-PARATY</span>
        <span>البرطي المالي الشامل | Al-ParatY Financial Enterprise</span>
      </div>
      <div class="onyx-title-right">
        <div class="onyx-title-info-item" style="display:flex; align-items:center; gap:6px;">
          <button id="btn-show-login-modal" class="onyx-btn" onclick="window.onyxApp.showLoginModal()" style="background:#0f2b5c; color:#93c5fd; border:1px solid #1e3a8a; font-size:11px; padding:2px 8px; border-radius:3px; cursor:pointer; font-weight:bold; display:flex; align-items:center; gap:4px;">🔑 شاشة تسجيل الدخول</button>
          <button id="btn-toggle-ui-mode" class="onyx-btn" onclick="window.onyxApp.toggleInterfaceMode()" style="background:#0284c7; color:#fff; border:1px solid #38bdf8; font-size:11px; padding:2px 8px; border-radius:3px; cursor:pointer; font-weight:bold;">🏪 معاينة واجهة الفرع</button>
        </div>
        <div class="onyx-title-info-item">
          <span>الفرع:</span>
          <strong id="titlebar-branch-display">01 - المركز الرئيسي (صنعاء)</strong>
        </div>
        <div class="onyx-title-info-item">
          <span>السنة المالية:</span>
          <strong>2026</strong>
        </div>
        <div class="onyx-title-info-item">
          <span>المستخدم:</span>
          <strong id="titlebar-user-display">1 - المدير المالي (أحمدسليم البرطي)</strong>
        </div>
        <div class="onyx-title-info-item">
          <span>العملة:</span>
          <strong>ريال يمني (YER)</strong>
        </div>
      </div>
    </header>

    <!-- 2. Onyx Menubar (شريط القوائم والأنظمة التنفيذي - واضح ومميز بالأيقونات لجميع متطلبات النظام) -->
    <nav class="onyx-menubar" id="top-nav-bar">
      <div class="onyx-menu-item active" data-screen="dashboard" onclick="window.onyxApp.openScreen('dashboard')">
        <span class="menu-icon">📊</span>
        <span>الرئيسية</span>
      </div>
      <div class="onyx-menu-item" data-screen="system_config" onclick="window.onyxApp.openScreen('system_config')">
        <span class="menu-icon">⚙️</span>
        <span>تهيئة النظام</span>
      </div>
      <div class="onyx-menu-item" data-screen="security_users" onclick="window.onyxApp.openScreen('security_users')">
        <span class="menu-icon">🔒</span>
        <span>المستخدمون والصلاحيات</span>
      </div>
      <div class="onyx-menu-item" data-screen="chart_of_accounts"
        onclick="window.onyxApp.openScreen('chart_of_accounts')">
        <span class="menu-icon">🌳</span>
        <span>الدليل المحاسبي</span>
      </div>
      <div class="onyx-menu-item" data-screen="opening_balances"
        onclick="window.onyxApp.openScreen('opening_balances')">
        <span class="menu-icon">⚖️</span>
        <span>الأرصدة الافتتاحية</span>
      </div>
      <div class="onyx-menu-item" data-screen="journal_entries" onclick="window.onyxApp.openScreen('journal_entries')">
        <span class="menu-icon">📓</span>
        <span>القيود اليومية</span>
      </div>
      <div class="onyx-menu-item" data-screen="vouchers_cash" onclick="window.onyxApp.openScreen('vouchers_cash')">
        <span class="menu-icon">💵</span>
        <span>سندات الصرف والقبض</span>
      </div>
      <div class="onyx-menu-item" data-screen="vouchers_cheque" onclick="window.onyxApp.openScreen('vouchers_cheque')">
        <span class="menu-icon">🏦</span>
        <span>الشيكات والبنك الوسيط</span>
      </div>
      <div class="onyx-menu-item" data-screen="expenses" onclick="window.onyxApp.openScreen('expenses')">
        <span class="menu-icon">💸</span>
        <span>المصروفات والنثريات</span>
      </div>
      <div class="onyx-menu-item" data-screen="fixed_assets" onclick="window.onyxApp.openScreen('fixed_assets')">
        <span class="menu-icon">🏢</span>
        <span>الأصول الثابتة</span>
      </div>
      <div class="onyx-menu-item" data-screen="payroll" onclick="window.onyxApp.openScreen('payroll')">
        <span class="menu-icon">👥</span>
        <span>المرتبات والأجور</span>
      </div>
      <div class="onyx-menu-item" data-screen="org_hierarchy_excel"
        onclick="window.onyxApp.openScreen('org_hierarchy_excel')">
        <span class="menu-icon">📊</span>
        <span>جدول إكسل الهيكل</span>
      </div>
      <div class="onyx-menu-item" data-screen="purchases_lc" onclick="window.onyxApp.openScreen('purchases_lc')">
        <span class="menu-icon">🛒</span>
        <span>المشتريات والاعتمادات</span>
      </div>
      <div class="onyx-menu-item" data-screen="sales" onclick="window.onyxApp.openScreen('sales')">
        <span class="menu-icon">🏷️</span>
        <span>المبيعات والعملاء (إكسل)</span>
      </div>
      <div class="onyx-menu-item" data-screen="pos" onclick="window.onyxApp.openScreen('pos')">
        <span class="menu-icon">🖥️</span>
        <span>نقطة البيع (POS)</span>
      </div>
      <div class="onyx-menu-item" data-screen="inventory" onclick="window.onyxApp.openScreen('inventory')">
        <span class="menu-icon">📦</span>
        <span>المخازن والمستودعات</span>
      </div>
      <div class="onyx-menu-item" data-screen="review_posting" onclick="window.onyxApp.openScreen('review_posting')">
        <span class="menu-icon">🛡️</span>
        <span>المراجعة والترحيل</span>
      </div>
      <div class="onyx-menu-item" data-screen="reports" onclick="window.onyxApp.openScreen('reports')">
        <span class="menu-icon">📈</span>
        <span>التقارير الختامية</span>
      </div>
    </nav>

    <!-- 3. Iconic Action Toolbar (شريط أدوات أونكس برو الشهير) -->
    <div class="onyx-toolbar">
      <div class="onyx-toolbar-group">
        <button class="onyx-btn-tool" onclick="window.onyxApp.handleF6()" title="إضافة سجل جديد [F6]">
          <span>➕</span>
          <span>إضافة</span>
          <span class="kbd">F6</span>
        </button>

        <button class="onyx-btn-tool btn-save" onclick="window.onyxApp.handleF10()" title="حفظ البيانات [F10]">
          <span>💾</span>
          <span>حفظ</span>
          <span class="kbd">F10</span>
        </button>

        <button class="onyx-btn-tool" onclick="location.reload()" title="تحديث وعرض البيانات [F5]">
          <span>🔄</span>
          <span>عرض</span>
          <span class="kbd">F5</span>
        </button>

        <button class="onyx-btn-tool" onclick="window.onyxApp.handleF7()" title="بحث واستعلام [F7 / F8]">
          <span>🔍</span>
          <span>بحث</span>
          <span class="kbd">F7</span>
        </button>

        <button class="onyx-btn-tool" onclick="window.print()" title="طباعة المستند أو التقرير [Shift+F8]">
          <span>🖨️</span>
          <span>طباعة</span>
          <span class="kbd">Shift+F8</span>
        </button>

        <button class="onyx-btn-tool btn-del" onclick="window.onyxApp.handleShiftF6()" title="حذف السجل [Shift+F6]">
          <span>❌</span>
          <span>حذف</span>
          <span class="kbd">Shift+F6</span>
        </button>

        <div class="onyx-toolbar-sep"></div>

        <!-- أسهم التنقل بين السجلات -->
        <div class="onyx-nav-arrows">
          <button class="onyx-btn-nav" onclick="window.onyxApp.navigateRecords('first')" title="أول سجل">|◀</button>
          <button class="onyx-btn-nav" onclick="window.onyxApp.navigateRecords('prev')" title="السجل السابق">◀</button>
          <button class="onyx-btn-nav" onclick="window.onyxApp.navigateRecords('next')" title="السجل التالي">▶</button>
          <button class="onyx-btn-nav" onclick="window.onyxApp.navigateRecords('last')" title="آخر سجل">▶|</button>
        </div>
      </div>

      <div class="onyx-toolbar-group">
        <button class="onyx-btn-tool" style="background:#eff6ff; border-color:#93c5fd; color:#1e40af;"
          onclick="window.onyxApp.exportSystemBackup()" title="تصدير نسخة احتياطية كاملة للبيانات (.json)">
          <span>💾</span>
          <span>نسخ احتياطي</span>
        </button>

        <button class="onyx-btn-tool" style="background:#f0fdf4; border-color:#86efac; color:#15803d;"
          onclick="window.onyxApp.openImportSystemBackupModal()" title="استعادة نسخة احتياطية من ملف (.json)">
          <span>📥</span>
          <span>استعادة نسخة</span>
        </button>

        <button class="onyx-btn-tool" style="background:#fef3c7; border-color:#fde047; color:#854d0e;"
          onclick="window.onyxApp.resetDatabase()" title="تصفير البيانات والبدء على بياض">
          <span>🧹</span>
          <span>تصفير النظام</span>
        </button>

        <button class="onyx-btn-tool" style="background:#fee2e2; border-color:#fca5a5; color:#991b1b;"
          onclick="window.close()" title="خروج من النظام [Alt+F4]">
          <span>🚪</span>
          <span>خروج</span>
          <span class="kbd">Alt+F4</span>
        </button>
      </div>
    </div>

    <!-- 4. Body Layout (Navigation Tree Sidebar + Form Workspace) -->
    <div class="onyx-body-layout">

      <!-- شجرة مستكشف أونكس برو الجانبية - كامل الوحدات الوظيفية 1 إلى 12 -->
      <aside class="onyx-tree-sidebar">
        <div class="onyx-sidebar-header">
          <span>🗂️</span>
          <span>شاشات البرطي المالي الشامل (Al-ParatY)</span>
        </div>

        <!-- 1. تهيئة النظام -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>⚙️ 1. تهيئة النظام</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="system_config">
              <span>▪</span> <span>فترات النظام والعملات (FR-2.1)</span>
            </div>
          </div>
        </div>

        <!-- 2. الصلاحيات والأمان -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>🔒 2. الصلاحيات والأمان</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="security_users">
              <span>▪</span> <span>المستخدمون والصلاحيات (FR-2.5)</span>
            </div>
          </div>
        </div>

        <!-- 3. نظام الأستاذ العام -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>📓 3. نظام الأستاذ العام</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="chart_of_accounts">
              <span>▪</span> <span>الدليل المحاسبي (COA)</span>
            </div>
            <div class="onyx-tree-item" data-screen="opening_balances">
              <span>▪</span> <span>الأرصدة الافتتاحية (ص 14)</span>
            </div>
            <div class="onyx-tree-item" data-screen="journal_entries">
              <span>▪</span> <span>القيود اليومية العامة (ص 15)</span>
            </div>
          </div>
        </div>

        <!-- 4. الصناديق والبنوك والشيكات -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>💳 4. الصناديق والبنوك والشيكات</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="vouchers_cash">
              <span>▪</span> <span>سندات الصرف والقبض (نقداً)</span>
            </div>
            <div class="onyx-tree-item" data-screen="vouchers_cheque">
              <span>▪</span> <span>سندات الشيكات والبنك الوسيط</span>
            </div>
            <div class="onyx-tree-item" data-screen="cheque_collection">
              <span>▪</span> <span>التحصيل اليدوي للشيكات (ص 23)</span>
            </div>
          </div>
        </div>

        <!-- 4.1 نظام المصروفات والنثريات -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>💸 5. نظام المصروفات والنثريات</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="expenses">
              <span>▪</span> <span>إدارة وقيد المصروفات (FR-Expenses)</span>
            </div>
          </div>
        </div>

        <!-- 5. نظام الأصول الثابتة -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>🏢 5. نظام الأصول الثابتة</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="fixed_assets">
              <span>▪</span> <span>كروت الأصول وإهلاكها (FR-8)</span>
            </div>
          </div>
        </div>

        <!-- 6. نظام المرتبات والأجور -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>👥 6. المرتبات والأجور (HR)</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="payroll">
              <span>▪</span> <span>مسيرات الرواتب والغياب (ص 27)</span>
            </div>
            <div class="onyx-tree-item" data-screen="org_hierarchy_excel">
              <span>▪</span> <span>الهيكل الإداري وجدول إكسل (ص 29)</span>
            </div>
          </div>
        </div>

        <!-- 7. نظام إدارة المشتريات -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>🛒 7. المشتريات والاعتمادات</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="purchases_lc">
              <span>▪</span> <span>فواتير المشتريات والاعتمادات CF</span>
            </div>
          </div>
        </div>

        <!-- 8. نظام إدارة المبيعات -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>🏷️ 8. المبيعات ونقاط البيع</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="sales">
              <span>▪</span> <span>فواتير المبيعات وجدول إكسل (FR-6)</span>
            </div>
            <div class="onyx-tree-item" onclick="window.onyxApp.openInvoiceProfilesManagerModal()">
              <span>▪</span> <span>محرك أنماط الفواتير (Invoice Profiles)</span>
            </div>
            <div class="onyx-tree-item" data-screen="pos">
              <span>▪</span> <span>نقطة البيع السريعة (POS الكاشير)</span>
            </div>
          </div>
        </div>

        <!-- 9. نظام إدارة المخازن -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>📦 9. المخازن وجرد الأصناف</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="inventory">
              <span>▪</span> <span>أرصدة المخازن وفروقات الجرد</span>
            </div>
          </div>
        </div>

        <!-- 10. نظام المراجعة والترحيل -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>🛡️ 10. المراجعة والترحيل</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="review_posting">
              <span>▪</span> <span>مركز المراجعة والترحيل (FR-8.1)</span>
              <span class="onyx-badge-count" id="tree-pending-count" style="display:none;">0</span>
            </div>
          </div>
        </div>

        <!-- 11. التقارير المالية والختامية -->
        <div class="onyx-tree-group">
          <div class="onyx-tree-header">
            <span>📊 11. التقارير الختامية</span>
          </div>
          <div class="onyx-tree-list">
            <div class="onyx-tree-item" data-screen="reports">
              <span>▪</span> <span>ميزان المراجعة والميزانية (FR-9)</span>
            </div>
          </div>
        </div>
      </aside>

      <!-- مساحة العمل الرئيسية للشاشات (Workspace Canvas) -->
      <main class="onyx-workspace-area">
        <!-- شريط تعريف الشاشة النشطة -->
        <div style="display:none;">
          <span id="onyx-screen-title"></span>
          <span id="onyx-screen-sub"></span>
        </div>

        <!-- مكان تحميل الشاشات ديناميكياً بواسطة onyx_app.js (مع عرض فوري للرئيسية لمنع أي شاشة زرقاء أو تأخير) -->
        <div id="onyx-workspace">
          <!-- بطاقة رأس المال المستخرج من الأرصدة الافتتاحية -->
          <div class="onyx-groupbox">
            <span class="onyx-groupbox-legend">نقطة بداية النشاط ورأس المال المحسوب آلياً (الأصول - الخصوم)</span>
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px;">
              <div style="background:#f8fafc; border:1px solid #cbd5e1; padding:10px; border-radius:3px;">
                <div style="color:#64748b; font-size:11px; font-weight:700;">إجمالي الأصول الافتتاحية (مدين)</div>
                <div style="font-size:16px; font-weight:900; color:#0f2b5c; margin-top:4px;" class="num-cell">0.00 ر.ي
                </div>
                <div style="font-size:10px; color:#15803d; margin-top:2px;">✔ تشمل الصناديق والبنوك والأصول الثابتة
                </div>
              </div>

              <div style="background:#f8fafc; border:1px solid #cbd5e1; padding:10px; border-radius:3px;">
                <div style="color:#64748b; font-size:11px; font-weight:700;">إجمالي الخصوم والالتزامات (دائن)</div>
                <div style="font-size:16px; font-weight:900; color:#b91c1c; margin-top:4px;" class="num-cell">0.00 ر.ي
                </div>
                <div style="font-size:10px; color:#475569; margin-top:2px;">مستحقات الموردين والشركات بالأجل</div>
              </div>

              <div style="background:#eff6ff; border:1px solid #93c5fd; padding:10px; border-radius:3px;">
                <div style="color:#1e40af; font-size:11px; font-weight:800;">رأس المال المدفوع المعتمد (صافي)</div>
                <div style="font-size:18px; font-weight:900; color:#1e40af; margin-top:4px;" class="num-cell">0.00 ر.ي
                </div>
                <div style="font-size:10px; color:#15803d; font-weight:700; margin-top:2px;">✔ متطابق مع معادلة أونكس (ص
                  14)</div>
              </div>

              <div style="background:#f8fafc; border:1px solid #cbd5e1; padding:10px; border-radius:3px;">
                <div style="color:#64748b; font-size:11px; font-weight:700;">السيولة بالصناديق (محلي ومعادل)</div>
                <div style="font-size:16px; font-weight:900; color:#0369a1; margin-top:4px;" class="num-cell">0.00 ر.ي
                </div>
                <div style="font-size:10px; color:#475569; margin-top:2px;">صنعاء + عدن (ريال، دولار، يورو)</div>
              </div>
            </div>
          </div>

          <!-- آخر العمليات المحاسبية المسجلة -->
          <div class="onyx-groupbox">
            <span class="onyx-groupbox-legend">سجل القيود اليومية المسجلة وحالة الترحيل</span>
            <div class="onyx-grid-container">
              <table class="onyx-grid">
                <thead>
                  <tr>
                    <th>رقم القيد</th>
                    <th>التاريخ</th>
                    <th>البيان المحاسبي</th>
                    <th>الفرع</th>
                    <th>إجمالي المبلغ</th>
                    <th>حالة الوثيقة</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td colspan="6" style="text-align:center; padding:30px 15px; color:#64748b;">
                      <div style="font-size:14px; font-weight:700; color:#334155; margin-bottom:4px;">✨ قاعدة البيانات
                        نظيفة وخالية من أي قيود تجريبية</div>
                      <div style="font-size:11.5px; color:#64748b;">النظام جاهز لبدء النشاط الفعلي — اضغط على زر
                        <strong>إضافة [F6]</strong> لتسجيل أول قيد محاسبي أو سند صرف/قبض</div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- 5. Onyx Persistent Statusbar (شريط الحالة السفلي الدائم) -->
