        <div id="branchProfilesList" class="profiles-btn-list"></div>
      </div>
      <div class="branch-shift-status" id="branchShiftStatus"></div>
      <div class="branch-support-box">
        <small>مركز الدعم الفني وخدمة العملاء: 8000000</small>
      </div>
      <div id="branchAdminNav" style="margin-top:auto; padding-top:10px; display:flex; flex-direction:column; gap:6px;">
        <button id="btnReturnEnterprise" class="profile-action-btn" style="width:100%; justify-content:center; background:#1e3a8a; color:#fff; border-color:#172554;" onclick="window.onyxApp.returnToEnterprise()">
          🏢 العودة للمركز الرئيسي
        </button>
        <button id="btnBranchShowLogin" class="profile-action-btn" style="width:100%; justify-content:center; background:#0f172a; color:#93c5fd; border-color:#334155;" onclick="window.onyxApp.showLoginModal()">
          🔑 شاشة تسجيل الدخول
