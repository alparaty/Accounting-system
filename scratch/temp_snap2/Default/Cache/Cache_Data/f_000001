          <span>الخادم متصل</span>
        </div>
      </div>

      <!-- 2. بطاقات الدخول السريع (Quick Login Presets) -->
      <div class="onyx-login-presets-bar">
        <span class="onyx-login-presets-label">⚡ الدخول السريع:</span>
        <button type="button" class="onyx-login-preset-chip active" id="chip-user-1" onclick="window.onyxApp.quickFillLogin('1', '01', '1')" title="تسجيل الدخول المباشر كمدير عام">
          👑 1 - المدير العام (HQ)
        </button>
        <button type="button" class="onyx-login-preset-chip" id="chip-user-2" onclick="window.onyxApp.quickFillLogin('2', '01', '2')" title="تسجيل الدخول ككاشير صالة صنعاء">
          🏪 2 - كاشير صنعاء (Retail)
        </button>
        <button type="button" class="onyx-login-preset-chip" id="chip-user-3" onclick="window.onyxApp.quickFillLogin('3', '02', '2')" title="تسجيل الدخول ككاشير فرع عدن">
          🚚 3 - كاشير عدن (Retail)
        </button>
      </div>

      <!-- 3. شبكة الحقول الرئيسية المطابقة تماماً لنموذج أونكس برو القياسي -->
      <div class="onyx-login-body">
        <form id="onyxLoginForm" onsubmit="window.onyxApp.handleLoginSubmit(event)">
          <table class="onyx-login-form-table">
            <tbody>
              <!-- 1. السنة -->
              <tr>
                <td class="onyx-login-table-label">السنة</td>
                <td class="onyx-login-table-control">
                  <input type="number" id="login-year" class="onyx-login-input" value="2026" min="2020" max="2035" required autocomplete="off">
                </td>
              </tr>

              <!-- 2. اللغة -->
              <tr>
                <td class="onyx-login-table-label">اللغة</td>
                <td class="onyx-login-table-control">
                  <select id="login-lang" class="onyx-login-select">
                    <option value="ar" selected>1 - عربي</option>
                    <option value="en">2 - English</option>
                  </select>
                </td>
              </tr>

              <!-- 3. الوحدة المحاسبية -->
              <tr>
                <td class="onyx-login-table-label">الوحدة المحاسبية</td>
                <td class="onyx-login-table-control">
                  <select id="login-acc-unit" class="onyx-login-select">
                    <option value="1" selected>1 - المركز الرئيسي / الإدارة العامة (صنعاء)</option>
                    <option value="2">2 - قطاع المبيعات والتسويق ومعارض التجزئة</option>
                    <option value="3">3 - قطاع الاستثمار والمشاريع وتطوير الأعمال</option>
                  </select>
                </td>
              </tr>

              <!-- 4. المستخدم -->
              <tr>
                <td class="onyx-login-table-label">المستخدم</td>
                <td class="onyx-login-table-control">
                  <div style="display:flex; gap:6px;">
                    <input type="text" id="login-user-code" class="onyx-login-input" value="1" style="width:65px; text-align:center; font-weight:bold;" oninput="window.onyxApp.onLoginUserCodeInput(this.value)" autocomplete="username" required>
                    <select id="login-user-select" class="onyx-login-select" style="flex:1;" onchange="window.onyxApp.onLoginUserSelect(this.value)">
                      <option value="1" selected>1 - المدير المالي (خالد رضوان)</option>
                      <option value="2">2 - مروان صالح القدسي (كاشير الفرع)</option>
                      <option value="3">3 - صالح محمد العولقي (فرع عدن)</option>
                    </select>
                  </div>
                </td>
              </tr>

              <!-- 5. كلمة السر -->
              <tr>
                <td class="onyx-login-table-label">كلمة السر</td>
                <td class="onyx-login-table-control">
                  <div class="onyx-login-password-wrap">
                    <input type="password" id="login-password" class="onyx-login-input" value="1" style="padding-left:30px;" autocomplete="current-password" required onkeyup="window.onyxApp.checkCapsLock(event)">
                    <button type="button" class="onyx-login-toggle-pass" onclick="window.onyxApp.togglePasswordVisibility()" title="إظهار / إخفاء كلمة السر">👁️</button>
                    <div id="login-caps-alert" class="onyx-login-caps-alert">⚠ تنبيه: مفتاح Caps Lock مفعل</div>
                  </div>
                </td>
              </tr>

              <!-- 6. رقم الفرع -->
              <tr>
                <td class="onyx-login-table-label">رقم الفرع</td>
                <td class="onyx-login-table-control">
                  <select id="login-branch" class="onyx-login-select">
                    <option value="01" selected>1 - فرع صنعاء _ المركز الرئيسي</option>
                    <option value="02">2 - فرع عدن _ التوزيع والموانئ</option>
                    <option value="03">3 - فرع المكلا _ المستودعات الساحلية</option>
                  </select>
                </td>
              </tr>

              <!-- 7. الشركة -->
              <tr>
                <td class="onyx-login-table-label">الشركة</td>
                <td class="onyx-login-table-control">
                  <select id="login-company" class="onyx-login-select">
                    <option value="1" selected>1 - شركة البرطي التجارية والاستثمارية</option>
                    <option value="2">2 - مركز نوبل للاستشارات وأنظمة المعلومات</option>
                  </select>
                </td>
              </tr>

              <!-- 8. النظام -->
              <tr>
                <td class="onyx-login-table-label">النظام</td>
                <td class="onyx-login-table-control">
                  <select id="login-system-module" class="onyx-login-select">
                    <option value="1" selected>1 - نظام الأستاذ العام والحسابات المالية (HQ Enterprise Classic)</option>
                    <option value="2">2 - نظام إدارة المعارض والمبيعات ونقاط البيع (Branch Retail Hub)</option>
                    <option value="3">3 - نظام إدارة المخازن والمستودعات والتوريدات</option>
                    <option value="4">4 - نظام إدارة المشتريات والاعتمادات المستندية</option>
                    <option value="5">5 - نظام الموارد البشرية والرواتب والأجور</option>
                  </select>
                </td>
              </tr>
            </tbody>
          </table>
        </form>
      </div>

      <!-- 4. شريط الأزرار (<<< - خروج - موافق) -->
      <div class="onyx-login-footer">
        <button type="button" id="btnLoginDrawer" class="onyx-login-btn-drawer" onclick="window.onyxApp.toggleLoginDrawer()" title="إعدادات الاتصال وبيئة العمل المتقدمة">&lt;&lt;&lt;</button>
        <div class="onyx-login-buttons-main">
          <button type="button" class="onyx-login-btn onyx-login-btn-exit" onclick="window.onyxApp.closeLoginModal()">خروج [Esc]</button>
          <button type="button" class="onyx-login-btn onyx-login-btn-ok" onclick="window.onyxApp.handleLoginSubmit(event)">موافق [Enter]</button>
        </div>
      </div>

      <!-- 5. درج الإعدادات المتقدمة (<<<) -->
      <div id="onyxLoginDrawer" class="onyx-login-drawer">
        <div class="onyx-login-drawer-grid">
          <div class="onyx-login-drawer-item">
            <label>عنوان خادم النظام المحلي (Host)</label>
            <span>http://127.0.0.1:8999</span>
          </div>
          <div class="onyx-login-drawer-item">
            <label>قاعدة البيانات المحلية</label>
            <span>SQLite 3 (alparaty_erp.db)</span>
          </div>
          <div class="onyx-login-drawer-item">
            <label>النسخ الاحتياطي التلقائي</label>
            <span style="color:#4ade80;">✔ مفعّل وتلقائي على القرص</span>
          </div>
          <div class="onyx-login-drawer-item" style="flex-direction:row; align-items:center; gap:6px; margin-top:4px;">
            <input type="checkbox" id="login-remember-me" checked style="accent-color:#0284c7; cursor:pointer;">
            <label for="login-remember-me" style="color:#e2e8f0; cursor:pointer; font-size:11px;">تذكر بيانات الجلسة على هذا الحاسوب</label>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- حاوية النوافذ المنبثقة وحوارات F9 -->
  <div class="onyx-modal-backdrop" id="onyx-modal-area"></div>

  <!-- حاوية التنبيهات الفورية -->
  <div class="onyx-toast-area" id="onyx-toast-area"></div>

  <!-- ملفات منطق وبيانات أونكس برو -->
  <script src="js/onyx_data.js?v=20261011_v11"></script>
  <script src="js/onyx_store.js?v=20261011_v11"></script>
  <script src="js/onyx_app.js?v=20261011_v11"></script>

</body>

</html>